# vim:filetype=bash
#
# functions here will only load for the system on which scrash is running

# -pw retrieves a password based on the given key, which can be supplied as arg
# 1 or passed in stdin
#
# limitation: password cannot contain a colon because that is assumed to be the
# delimiter here
-pw-localhost() {
  local opt OPTIND search_key pw_line pw n index=-1 split_char=':' b64=0 pw_file="$SCR_PASSWORD_FILE" found=0 mode=query git_dir new_pw_entry
  while builtin getopts "cdhbi:p:eIA:a:" opt; do
    case $opt in
      (h)
        echo "usage: $FUNCNAME [-cdhbeI][-i index][-a new_pw_entry][-p password_file] search_key"
        echo "-h: this help"
        echo "-b: base64 encode the result"
        echo "-a: append a new entry to the password file"
        echo "-c: commit changes"
        echo "-d: show diff on uncommitted changes"
        echo "-e: edit the password file"
        echo "-i: for each matched line, return this index value of the line when it is split by \"$split_char\""
        echo "-I: check for existence of password file, and initialize it if necessary"
        echo "-p: specify an alternate password file, default=$pw_file"
        return
        ;;
      (a)
        mode=append
        new_pw_entry="$OPTARG"
        ;;
      (A)
        # remote-request entry point: getPassword (Server.js) calls us with the
        # -pw args base64-serialized. When SCR_REMOTE_PW_CONFIRM=1, require the
        # local user to approve before any lookup happens.
        local args arg
        -deserialize-args $OPTARG
        if [ "$SCR_REMOTE_PW_CONFIRM" = 1 ] && ! -pw-confirm "${args[@]}"; then
          echo "$FUNCNAME: remote password request denied" >&2
          return 1
        fi
        $FUNCNAME "${args[@]}"
        return $?
        ;;
      (b)
        b64=1
        ;;
      (i)
        # for each line found, within that line what part of the line do we want?
        # default is the last index
        index=$OPTARG
        ;;
      (I)
        mode=init
        ;;
      (p)
        pw_file="$OPTARG"
        ;;
      (e)
        mode=edit
        ;;
      (d)
        mode=diff
        ;;
      (c)
        mode=commit
        # break and let remaining flags pass to "git commit"
        break
        ;;
    esac
  done
  shift $(($OPTIND-1))
  git_dir=$(dirname "$pw_file")
  case $mode in
    (append)
      {
        gpg -qd "$pw_file"
        echo "$new_pw_entry"
      } | gpg --batch --yes -r $SCR_PASSWORD_KEY_ID -eao "$pw_file"
      ;;
    (init)
      if [ $SCR_SSH_LEVEL -gt 0 ]; then
        echo "cannot do this at SCR_SSH_LEVEL=$SCR_SSH_LEVEL" >&2
        return 1
      fi
      if [ ! -f "$pw_file" ]; then
        # create a blank password file
        local tmpfile=$(mktemp)
        printf "#\n# enter secrets here in this format:\n# <login url or description>:<username>:<password>\n#\n" > $tmpfile
        gpg --batch --yes -ea -r $SCR_PASSWORD_KEY_ID -o $pw_file $tmpfile
        rm $tmpfile
        echo "just created $pw_file, you should add it to git now"
      fi
      ;;
    (edit)
      if [ $SCR_SSH_LEVEL -gt 0 ]; then
        echo "cannot do this at SCR_SSH_LEVEL=$SCR_SSH_LEVEL" >&2
        return 1
      fi
      vim "$pw_file"
      if ! $FUNCNAME -d; then
        read -p "commit changes to $pw_file (y/n, default=n)? "
        if [ "$REPLY" = y ]; then
          $FUNCNAME -c
        fi
      fi
      ;;
    (query)
      search_key="$1"
      if [ -z "$search_key" ]; then
        return 1
      fi
      shift
      if [ $SCR_SSH_LEVEL = 0 ]; then
        if [ ! -r "$pw_file" ]; then
          echo "$FUNCNAME: could not read password file: $pw_file" >&2
          return 1
        fi
        while read -r pw_line; do
          found=1
          IFS="$split_char" builtin read -r -a pw_line <<<"$pw_line"
          if [ "$index" ]; then
            let n=$index || true
          else
            let n=${#pw_line[*]}-1
          fi
          pw="${pw_line[$n]}"
          if [ $b64 = 0 ]; then
            echo "$pw"
          else
            printf "%s\n" $(printf %s "$pw" | openssl enc -a -A)
          fi
        done < <(gpg -qd "$pw_file" | grep -v ^# | grep "$search_key" || true)
        if [ $found = 0 ]; then
          return 1
        fi
      elif -ws /scr-get-password --data-urlencode "searchKey=$search_key" --data-urlencode "b64=$b64"  --data-urlencode "index=$index" --data-urlencode "pwFile=$pw_file" "$@"; then
        :
      else
        echo "$FUNCNAME: problem with OTP" >&2
        return 1
      fi
      ;;
    (diff)
      (
        cd "$git_dir"
        if ! git diff --quiet $(basename "$pw_file"); then
          diff <(git diff $(basename "$pw_file") | patch -R -p 0 -o - $(basename "$pw_file") | gpg -qd) <(gpg -qd "$pw_file")
        fi
      )
      ;;
    (commit)
      (
        cd "$git_dir"
        if ! git diff --quiet $(basename "$pw_file"); then
          git commit $(basename "$pw_file") "$@"
        fi
      )
      ;;
  esac
}

# Prompt the local user (in a fresh gnu screen window) to approve a remote
# password request. Returns 0 to approve, non-zero to deny. Fail-closed: a
# missing screen session, any setup error, or no answer within the timeout all
# deny. Args are the (untrusted, remote-supplied) -pw arguments; they are
# stripped to printable characters so they cannot spoof the prompt. Only ever
# runs locally (it is in SCR_LOCALHOST_FUNCS).
-pw-confirm() {
  local timeout=${SCR_REMOTE_PW_CONFIRM_TIMEOUT:-30} dir fifo label decision=deny
  if [ -z "$STY" ]; then
    echo "$FUNCNAME: no screen session (STY unset); denying" >&2
    return 1
  fi
  label=$(printf '%s ' "$@" | tr -cd '[:print:]')
  dir=$(mktemp -d) || return 1
  fifo="$dir/answer"
  if ! mkfifo -m 600 "$fifo"; then
    rm -rf "$dir"
    return 1
  fi
  # open the approval window in the local screen session and run
  # -pw-confirm-dialog in it (an exported localhost function, available in the
  # new window like every other scrash function -- same bash -c '"$@"' idiom
  # Server.js uses)
  env screen -X screen -t scrash-approval \
    bash -c '"$@"' -- -pw-confirm-dialog "$fifo" "$timeout" "$label"
  read -r -t $((timeout+5)) decision < "$fifo" || decision=deny
  rm -rf "$dir"
  [ "$decision" = approve ]
}

# Runs inside the fresh gnu screen window opened by -pw-confirm: shows the
# request, reads y/N with its own timeout, and writes the decision back over
# the fifo. Args: fifo timeout label
-pw-confirm-dialog() {
  local fifo="$1" timeout="$2" label="$3" ans
  clear 2>/dev/null || true
  cat <<'EOF'
============================================================
  scrash - REMOTE password request
============================================================

  A remote (ssh) session is requesting a password from your
  LOCAL encrypted store. Approve ONLY if you just initiated
  this yourself.
EOF
  # bold + bright yellow so the requested key stands out; safe to wrap in escapes
  # because -pw-confirm already stripped the label to printable characters
  printf '\n  request: \033[1;93m%s\033[0m\n\n' "$label"
  printf 'Press y within %ss to APPROVE; anything else (or timeout) DENIES: ' "$timeout"
  if read -r -t "$timeout" -n1 ans && [[ "$ans" =~ ^[Yy]$ ]]; then
    printf '\napprove\n'
    printf 'approve\n' > "$fifo"
  else
    printf '\ndeny\n'
    printf 'deny\n' > "$fifo"
  fi
}
