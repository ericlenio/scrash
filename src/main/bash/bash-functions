# vim:filetype=bash

-log() {
  if [ $# = 0 ]; then
    if [ "$SCR_DEBUG" = 1 ]; then
      export SCR_DEBUG=0
    else
      export SCR_DEBUG=1
    fi
    echo "logging is now $([ $SCR_DEBUG = 0 ] && echo OFF || echo ON)" >&2
    return
  fi
  if [ "$SCR_DEBUG" = 1 ]; then
    echo "$*" >&2
  fi
}

-add-path() {
  while [ $# -gt 0 ]; do
    [ -d "$1" ] && [[ ":$PATH:" != *":$1:"* ]] && PATH="$1:$PATH" && export PATH
    shift
  done
}

-tty-echo() {
  local tty=/dev/tty
  #if [ "$SSH_CLIENT" ]; then
    #tty=$SSH_TTY
  #fi
  if [ -e "$tty" ]; then
    echo "$@" >$tty
  fi
}

-vars() {
  set | egrep '^(EDITOR|SCR|STY|VIM|SSH|GIT_SSH|PSQLRC)' | sort
}

-clear-cache() {
  if [ "$SUDO_USER" ]; then
    -tty-echo "$FUNCNAME: skip because we detected sudo is in effect" >&2
    return
  fi
  if [[ "$SCR_TMPDIR" =~ ^/tmp/ ]]; then
    # keep the bin subdir
    find "$SCR_TMPDIR/bin" -mindepth 1 -exec rm -rf {} +
    find "$SCR_TMPDIR" -mindepth 1 -path "*/bin" -prune -o -exec rm -rf {} +
    -tty-echo "cleaned out $SCR_TMPDIR"
  fi
}

# is $1 owned by the user who started scrash? ($SUDO_UID when we are running
# under sudo, where we share the invoking user's $SCR_TMPDIR read-only.) ls -ldn
# rather than stat(1), whose flags differ across the platforms we run on: field 1
# is the mode string, field 3 the numeric owner
-check-owner() {
  local f="$1" uid want_uid=${SUDO_UID:-$EUID}
  if [ ! -e "$f" ]; then
    echo "$FUNCNAME: no such file: $f" >&2
    return 1
  fi
  set -- $(ls -ldn "$f")
  uid=$3
  if [ "$uid" != "$want_uid" ]; then
    echo "$FUNCNAME: $f is owned by uid $uid, expected $want_uid" >&2
    return 1
  fi
}

# $SCR_TMPDIR is a predictable path in a shared /tmp, and we write executables
# into it ($EDITOR, bin/git-ssh, bin/ssh-proxy-jump) and source files out of it
# (screenrc, scr-sty-env-*). so before trusting anything in there, make
# sure it is a real directory that belongs to us and that nobody else can write
# to -- otherwise someone may have created it (and planted those files) first.
# under sudo the directory belongs to the user who invoked sudo, which is why we
# compare against $SUDO_UID when it is set
-check-tmpdir() {
  local d dirs=("$1" "$1/bin") mode
  for d in "${dirs[@]}"; do
    [ -e "$d" ] || continue
    if [ -L "$d" ] || [ ! -d "$d" ]; then
      echo "$FUNCNAME: $d is not a directory" >&2
      return 1
    fi
    if ! -check-owner "$d"; then
      echo "$FUNCNAME: refusing to use $d" >&2
      return 1
    fi
    # tighten rather than refuse where we can: umask 002 is common enough that
    # insisting on a mode nobody else can write to would break working setups.
    # under sudo we are not the owner and cannot chmod, so there we only insist
    # that the world cannot write to it
    if [ -z "$SUDO_USER" ]; then
      if ! chmod go-w "$d"; then
        echo "$FUNCNAME: could not tighten permissions on $d" >&2
        return 1
      fi
      continue
    fi
    set -- $(ls -ldn "$d")
    mode=$1
    if [ "${mode:8:1}" = w ]; then
      echo "$FUNCNAME: refusing to use $d: mode $mode is writable by others" >&2
      return 1
    fi
  done
}

-random-string() {
  local length=${1:-16} r="" c
  while [ ${#r} -lt $length ]; do
    read -n 1 c
    r+=$c
  done < <(LC_ALL=C tr -dc A-Za-z0-9 </dev/urandom || true)
  echo $r
}

-pick-sty() {
  local stys pick_sty pick_sty_line session_id curr_sty=${STY:-no_such_sty_exists}
  # make a pick list of available session ids
  stys=$(
    while read l; do
      if [[ "$l" =~ ^[[:blank:]]*([0-9]+\.[^[:blank:]]+)[[:blank:]]+([[:print:]]+) ]]; then
        pick_sty=${BASH_REMATCH[1]}
        pick_sty_status=${BASH_REMATCH[2]}
        echo "$pick_sty $pick_sty_status"
      fi
    done < <(env screen -ls | grep -v $curr_sty)
  )
  if [ -z "$stys" ]; then
    echo "No screen sessions detected." >/dev/tty
    return 0
  fi
  if ! pick_sty_line=$(-pick-something "Resume which session?" "$stys"); then
    return 1
  fi
  if [[ $pick_sty_line =~ ^([0-9]+\.([-[:alnum:]]+)) ]]; then
    pick_sty=${BASH_REMATCH[1]}
    session_id=${BASH_REMATCH[2]}
    echo $session_id
  else
    echo "$FUNCNAME: no match for pick_sty_line: $pick_sty_line" >&2
    return 1
  fi
}

#
# call within gnu screen to update important environment variables; in
# particular, this must be called prior to any call to -ws or -ssh
-screen-env() {
  # SCR_SEED and SCR_SID are deliberately not in SCR_UPDATEABLE: they go in their
  # own file (see $SCR_STY_SEED below). SCR_SEED because it needs tighter
  # permissions than the rest, and SCR_SID because it has to move with the key it
  # names -- a process that cannot read the key must not pick up a newer id for
  # it, or it signs with one key while claiming another
  local opts="uS:p" opt OPTIND update=0 v SCR_UPDATEABLE="SCR_PORT SSH_AUTH_SOCK" \
    file_prefix=scr-sty-env- seed_prefix=scr-sty-seed- echo_port=0
  # keep STY local so we don't pollute parent shell when reconnecting to a gnu
  # screen session
  local STY=$STY
  while builtin getopts $opts opt; do
    case $opt in
      (u) update=1
        ;;
      (S) STY=$OPTARG
        ;;
      (p) echo_port=1
        ;;
    esac
  done
  if [ -z "$STY" ]; then
    echo "$FUNCNAME: no value for STY" >&2
    return 1
  fi
  local session_id=${STY##*.}
  local SCR_STY_ENV=$SCR_TMPDIR/$file_prefix$session_id
  # SCR_SEED is the key every request is signed with, so it gets a file of its own
  # at mode 600 instead of riding along in $SCR_STY_ENV, which stays world
  # readable: a sudo'd process (possibly running as another user) has to be able
  # to read the refreshed SCR_PORT out of it after a reconnect. SCR_SID travels
  # here too -- it is not a secret, but it names this key, and the two have to be
  # picked up together or not at all
  local SCR_STY_SEED=$SCR_TMPDIR/$seed_prefix$session_id
  local old_env old_env_id umask_save
  if [ -z "$SUDO_USER" ]; then
    for old_env in $SCR_TMPDIR/$file_prefix*; do
      if [[ $old_env =~ $file_prefix([:alnum:].*) ]]; then
        old_env_id=${BASH_REMATCH[1]}
        if ! screen -ls | grep -q $old_env_id; then
          rm -f $old_env $SCR_TMPDIR/$seed_prefix$old_env_id
          echo "removed old fifo: $old_env" >&2
        fi
      fi
    done
  fi
  if [ $update = 1 ]; then
    # update critical environment variables
    if {
      for v in $SCR_UPDATEABLE; do
        if [ "${!v}" ]; then
          printf "%s='%s'\n" $v ${!v}
        fi
      done
    } > $SCR_STY_ENV; then
      if [ "$SCR_SEED" ]; then
        # umask for the create, chmod for the case where the file already exists
        # (a redirection truncates it but keeps the old mode)
        umask_save=$(umask)
        umask 077
        if ! {
          printf "SCR_SEED='%s'\n" "$SCR_SEED"
          printf "SCR_SID='%s'\n" "$SCR_SID"
        } > $SCR_STY_SEED || ! chmod 600 $SCR_STY_SEED; then
          umask $umask_save
          echo "$FUNCNAME: failed to write to $SCR_STY_SEED" >&2
          return 1
        fi
        umask $umask_save
      fi
      printf "%s: successful update on %s:\n%s\n" $FUNCNAME $session_id "$(<$SCR_STY_ENV)" >&2
      return
    else
      echo "$FUNCNAME: failed to write to $SCR_STY_ENV" >&2
      return 1
    fi
  fi
  if [ ! -e $SCR_STY_ENV ]; then
    touch $SCR_STY_ENV
  fi
  # we are about to source these: $SCR_TMPDIR is a predictable path in a shared
  # /tmp, so a file there that is not ours was put there by somebody else
  if ! -check-owner $SCR_STY_ENV; then
    echo "$FUNCNAME: refusing to source $SCR_STY_ENV" >&2
    return 1
  fi
  if ! source $SCR_STY_ENV; then
    echo "$FUNCNAME: failed to load data from $SCR_STY_ENV" >&2
    return 1
  fi
  # an unreadable seed file means we are a sudo'd process running as a user that
  # is not allowed to see the key, which is fine: such a process keeps the
  # SCR_SEED/SCR_SID pair it booted with, and that key stays valid for as long as
  # the server is up (the id it was derived through does not change)
  if [ -r "$SCR_STY_SEED" ]; then
    if ! -check-owner $SCR_STY_SEED; then
      echo "$FUNCNAME: refusing to source $SCR_STY_SEED" >&2
      return 1
    fi
    if ! source $SCR_STY_SEED; then
      echo "$FUNCNAME: failed to load data from $SCR_STY_SEED" >&2
      return 1
    fi
  fi
  if [ $echo_port = 1 ]; then
    echo $SCR_PORT
  fi
}

# wrapper around gnu screen
screen() {
  local i i2 next_arg rcfile session_id_prefix="scr" session_id opt cmd=() screen_cmd=() esc=^Aa update=0 \
    command=0 skip=0 line rest \
    screen_ver=$([[ $(env screen -version) =~ ([[:digit:]]+) ]] && echo ${BASH_REMATCH[1]})
  for ((i=1;i<=$#;i++)); do
    i2=$((i+1))
    next_arg="${!i2}"
    opt="${!i}"
    skip=0
    case $opt in
      (--generate-session-id)
        printf "%s-%s" $session_id_prefix $(-random-string 4)
        return
        ;;
      (-ls|-list|-wipe|-Q|-D|-R)
        env screen "$@"
        return $?
        ;;
      (-X)
        if [ $update = 1 ]; then
          if ! -screen-env -S $session_id -u; then
            return $?
          fi
        fi
        env screen "$@"
        return $?
        ;;
      (-r)
        # rest: index of the first argument to keep after the "-r [session_id]"
        # we are about to rewrite
        rest=$((i+1))
        if [[ "$next_arg" =~ ^[[:alnum:]] ]]; then
          session_id=$next_arg
          # the session id came from the command line, so skip over it here or
          # we end up passing it to screen twice
          rest=$((i+2))
        else
          if ! session_id=$(-pick-sty); then
            return 1
          fi
        fi
        if [[ $session_id =~ ^$session_id_prefix ]]; then
          if ! -screen-env -S $session_id -u; then
            return $?
          fi
        fi
        set -- "${@:1:i-1}" -r $session_id "${@:$rest}"
        # assign rather than append: the "set --" above already rebuilt the
        # whole command line, including the options cmd picked up before the -r
        cmd=("$@")
        env screen "${cmd[@]}"
        return $?
        ;;
      (-u)
        set -- "${@:1:i-1}" "${@:i+1}"
        let i-=1
        skip=1
        update=1
        ;;
      (-S)
        session_id=$next_arg
        cmd+=(-S $session_id)
        let i+=1
        continue
        ;;
      (-c)
        rcfile=$next_arg
        cmd+=(-c $rcfile)
        let i+=1
        continue
        ;;
      ([a-zA-Z]*)
        screen_cmd=("${@:$i:$#}")
        break
        ;;
    esac
    [ $skip = 0 ] && cmd+=("$opt")
  done
  if ! [ "$session_id" ]; then
    session_id=$($FUNCNAME --generate-session-id)
    cmd+=(-S $session_id)
  fi
  # no $SCR_SCREENRC means no $SCR_TMPDIR to write it in (see -shell-init): screen
  # then starts with the user's own screenrc, or none
  if [ -z "$rcfile" -a "$session_id" -a "$SCR_SCREENRC" ]; then
    rcfile=$SCR_SCREENRC
    if [ ! -f $rcfile ]; then
      -screenrc | while read -r line; do
        if [[ "$line" =~ ^([[:digit:]]+):(.*)$ ]]; then
          ver=${BASH_REMATCH[1]}
          line="${BASH_REMATCH[2]}"
          if [ $ver -eq $screen_ver ]; then
            echo "$line"
          fi
        else
          echo "$line"
        fi
      done > $rcfile
    fi
    cmd+=(-c $rcfile)
  fi
  if [ $SCR_SSH_LEVEL -gt 0 ]; then
    esc=^Ee
  fi
  [ $TERM = dumb ] && TERM=screen
  # strip off "screen." prefix from $TERM to avoid "$TERM too long" issue
  cmd+=(-T ${TERM#screen.} -ln -e$esc)
  export SCR_SCREEN_START=$(date +%s)
  env screen "${cmd[@]}" "${screen_cmd[@]}"
}

# HMAC-SHA256 of $1, keyed with $SCR_SEED (or with $2 when given). both the key
# and the message are passed in the environment and never on a command line: on
# every host we ssh to, argv is readable by any local user (ps,
# /proc/PID/cmdline), so "openssl dgst -hmac $SCR_SEED" would hand the seed to
# anyone polling for it. perl's Digest::SHA is core, but fall back to openssl
# where it is somehow missing rather than fail outright
-hmac-sha256() {
  local mac
  if mac=$(SCR_HMAC_MSG="$1" SCR_HMAC_KEY="${2:-$SCR_SEED}" perl -MDigest::SHA=hmac_sha256_hex \
    -e 'print hmac_sha256_hex($ENV{SCR_HMAC_MSG},$ENV{SCR_HMAC_KEY})' 2>/dev/null) && [ ${#mac} = 64 ]; then
    printf "%s\n" $mac
    return
  fi
  printf %s "$1" | openssl dgst -sha256 -hmac "${2:-$SCR_SEED}" | awk '{print $2}'
}

# mint a session key for the next ssh hop: one random id, and a key derived from
# whatever key this shell holds. Server.js #sessionKey re-derives it from the id
# path alone, so nothing has to be registered anywhere. the id is not a secret
# (it selects a key, it does not prove anything), but it must be unpredictable:
# it ends up in log lines and, later, in whatever we key revocation on
#
# usage: -mint-session-key   ->   prints "<id path> <key>"
-mint-session-key() {
  local sid=$(openssl rand -hex 8)
  printf "%s %s\n" "${SCR_SID:+$SCR_SID.}$sid" "$(-hmac-sha256 "session:$sid")"
}

# args: method path [session_id_path [key]]. with no key we sign with this
# shell's own $SCR_SEED and identify ourselves with its $SCR_SID (empty on the
# machine running the server, where SCR_SEED *is* the master seed)
-scr-auth-header() {
  local method="${1:-GET}" path="$2" sid="${3-$SCR_SID}" key="${4-$SCR_SEED}" ts=$(date +%s) nc=$(openssl rand -hex 8) sig
  sig=$(-hmac-sha256 "${method}:${path}:${ts}:${nc}" "$key")
  echo "SCRASH-HMAC ${sid:+k=$sid,}t=${ts},n=${nc},s=${sig}"
}

-ws() {
  [ "$STY" ] && -screen-env
  local base_url=http://127.0.0.1:$SCR_PORT endpoint url rc=0
  endpoint=$1
  shift

  local base_path="${endpoint%%\?*}"
  local method="GET"

  local arg
  for arg in "$@"; do
    if [[ "$arg" == "--data"* || "$arg" == "-d"* ]]; then
      method="POST"
      break
    fi
  done

  local auth_header=$(-scr-auth-header "$method" "$base_path")

  printf -v url "%s%s" $base_url $endpoint
  set -- "$@" "$url"
  # hand the credential to curl through a config file on a pipe (-K) rather than
  # -H: a header on the command line is readable by any local user, and this
  # function runs on every host we ssh to. it has to be written on the curl line
  # itself -- bash closes the /dev/fd entry for a process substitution as soon as
  # the command it appeared in finishes, so it cannot be stashed in "$@" first
  if NO_PROXY=127.0.0.1 curl --connect-timeout 5 -f -S -s \
    -K <(printf 'header = "Authorization: %s"\n' "$auth_header") "$@"; then
    :
  else
    rc=$?
    echo "$FUNCNAME: curl failed with arguments: $@" >&2
    echo "stack trace: ${FUNCNAME[*]}" >&2
  fi
  return $rc
}

-ws-about() {
  -ws /scr-about "$@"
}

-ws-hello-world() {
  -ws /scr-hello-world "$@"
}

-screen-shot() {
  local f t
  if [ -z "$STY" ]; then
    echo "$FUNCNAME: not running gnu screen" >&2
    return 1
  fi
  f=$(mktemp)
  t=$RANDOM
  if [ "$EDITOR" -a ! -e "$EDITOR" ]; then
    v --version >/dev/null
  fi
  env screen -X hardcopy $f
  env screen -t $t sh -c "${EDITOR:-vim} -c \"set nonumber\" $f; rm $f"
  env screen -X select $t
}

# the whole vim configuration, verbatim: the profile vimrc first and then the vim
# plugins, which is the order vim would have used itself (vimrc, then the plugins
# under runtimepath). the $EDITOR wrapper built in vim() pipes this to vim on a
# file descriptor, so nothing here touches the filesystem and vim keeps its full
# configuration even where $SCR_TMPDIR cannot be written -- ssh'ing to a host with
# a readonly filesystem, say
-vim-config() {
  local f
  if declare -f -- -vimrc >/dev/null; then
    -vimrc
  fi
  for f in $(compgen -A function -- -vim-plugin-); do
    $f
  done
}

vim() {
  # what vim is told to run in place of reading a vimrc. it clears itself once it
  # has sourced: this value points at a file descriptor, so it is only meaningful
  # in the process that holds it, and leaving it in vim's environment would hand
  # every child of vim a $VIMINIT aimed at whatever their fd 3 turns out to be
  local viminit="source /dev/fd/3 | let \$VIMINIT = ''"
  local p d funcs_to_export="-ws -set-clipboard -get-clipboard -screen-env -scr-auth-header -hmac-sha256 -check-owner"
  if [ -z "$EDITOR" ]; then
    # there is no $SCR_TMPDIR to keep the wrapper in (see -shell-init), so hand
    # vim the configuration from right here: it travels on a file descriptor and
    # needs nothing on disk, which is why this still works on a readonly host
    if [ -d /dev/fd ]; then
      VIMINIT="$viminit" command vim "$@" 3< <(-vim-config)
    else
      command vim "$@"
    fi
    return
  fi
  d=$(dirname "$EDITOR")
  [ ! -d "$d" ] && mkdir -p "$d" 2>/dev/null
  if [ ! -e "$EDITOR" ]; then
    # the wrapper hands vim its configuration on a file descriptor: ":source
    # /dev/fd/3" is an ordinary :source of an ordinary path, so it gets a script
    # context (s: variables work) and runs in the buffer vim already opened for
    # the file, which is where a vimrc's buffer-local :set commands belong. that
    # makes it a faithful vimrc that never touches the disk, and because :source
    # of a path is as old as vim itself it is the only such mechanism that reaches
    # back to the vim 7.1 on Ubuntu 8. $VIMINIT is set here rather than in the
    # environment because it is only true while fd 3 is actually open.
    #
    # -vim-config is called rather than read out of a variable because the
    # configuration is already in the environment once, as the exported -vimrc and
    # -vim-plugin-* functions. the declare test is what decides whether we have it
    # at all: anything that sanitizes the environment (sudoedit) strips those
    # functions, and there is then nothing to hand over.
    #
    # the "exec 3<" is part of the condition rather than a statement inside it: a
    # failed redirection on an argument-less exec is not fatal, it just returns
    # non-zero, so running it separately would leave $VIMINIT pointing at a
    # descriptor we never opened
    p='#!/usr/bin/env bash\n%s\nexport -f -- %s\nif declare -f -- -vim-config >/dev/null && [ -d /dev/fd ] && exec 3< <(-vim-config); then\n  export VIMINIT=%q\nfi\nexec vim "$@"'
    # 2>/dev/null ahead of the write: redirections are set up left to right, so
    # putting it after would let the shell's own "cannot create" land on the
    # terminal in front of the clearer message below
    if ! printf "$p" "$(declare -f -- $funcs_to_export)" "$funcs_to_export" "$viminit" 2>/dev/null >"$EDITOR" ||
      ! chmod 755 "$EDITOR" 2>/dev/null; then
      # the wrapper is what carries the clipboard functions into vim's environment
      # past anything that sanitizes it. where we cannot write it we still hand
      # vim the configuration ourselves, and lose only the clipboard integration
      echo "$FUNCNAME: could not create $EDITOR, running vim without the scrash clipboard functions" >&2
      rm -f "$EDITOR" 2>/dev/null
      if [ -d /dev/fd ]; then
        VIMINIT="$viminit" command vim "$@" 3< <(-vim-config)
      else
        command vim "$@"
      fi
      return
    fi
  fi
  "$EDITOR" "$@"
}

-shell-init() {
  local opts="CDvs:" opt OPTIND log_tty verbose=0 f i fcns num_fcns test_mode=0 test_groups start clear_cache=0 declare_mode=0 show_test_groups version_file old_version tmpdir_ok
  while builtin getopts $opts opt; do
    case $opt in
      (v) verbose=1
        export SCR_DEBUG=1
        ;;
      (s)
        # pass start=1 to start an interactive shell, any other value is
        # assumed to be a base64 encoded command to be run (generated by
        # -ssh-serialize-cmd)
        start=$OPTARG
        ;;
      (D)
        # just declare all the functions
        declare_mode=1
        ;;
      (C)
        clear_cache=1
        ;;
    esac
  done
  if [ $declare_mode = 0 ]; then
    # SCR_ENV is like node's NODE_ENV, we can use it to create a separate name
    # space for run time files and such
    export SCR_ENV=${SCR_ENV:-dev}
    export SCR_TMPDIR=/tmp/scr-${SUDO_USER:-$USER}-$SCR_ENV-$SCR_PORT_0
    export EDITOR=$SCR_TMPDIR/bin/editor
    export SCR_SCREENRC=$SCR_TMPDIR/screenrc
    export SCR_SSH_USER_KNOWN_HOSTS=$SCR_TMPDIR/ssh-$SCR_SSH_USER-$SCR_SSH_HOST-known-hosts
    : ${SCR_SSH_LEVEL:=0}
    export SCR_SSH_LEVEL
    # nothing to set up for vim here: the configuration is already in the
    # environment as the exported -vimrc and -vim-plugin-* functions, and the
    # $EDITOR wrapper built in vim() calls -vim-config to hand it to vim on a file
    # descriptor. $VIMINIT is only correct while that descriptor is open, so the
    # wrapper sets it for the one invocation and we clear any we inherited --
    # otherwise a vim started some other way would try to source whatever fd 3
    # happens to be.
    #
    # a vim something else started (a script calling vim by path, say) has no
    # descriptor to read and so behaves like an unconfigured vim. there is nothing
    # useful to put in $VIMINIT for it: a command line cannot hold an :if or an
    # :augroup block, and running the configuration out of the environment as
    # commands needs ":source" of a buffer (vim 8.2.4594) or execute() (vim
    # 7.4.2008), neither of which exists on the vim 7.1 that ships with Ubuntu 8
    unset VIMINIT
    # for sudo users, if they use vim and SHELL is /bin/false (or similar) then
    # rvim is used (at least on macos)
    export SHELL=$BASH
    # set GIT_SSH so we can ensure SSH_AUTH_SOCK gets set when dealing with git
    # ssh-style URLs, see:
    # https://git-scm.com/book/en/v2/Git-Internals-Environment-Variables#_miscellaneous
    if command -v git >/dev/null; then
      export GIT_SSH=$SCR_TMPDIR/bin/git-ssh
    fi
    export SCR_SSH_PROXY_JUMP=$SCR_TMPDIR/bin/ssh-proxy-jump
    #[ -z "$SUDO_USER" ] && rm -f $EDITOR
    # a $SCR_TMPDIR we cannot have is not a reason to fail: this function ends by
    # exec'ing the shell (or the command) the login is for, and the far end of a
    # ssh boots by running it -- so returning non-zero here is an ssh that dies,
    # leaving no way onto the host at all. a readonly /tmp is the case that matters.
    # so we note it and carry on: everything below that needs a file in there is
    # skipped, and the variables naming those files are cleared rather than left
    # pointing at a directory we could not create or could not trust
    tmpdir_ok=1
    if [ -e "$SCR_TMPDIR" ]; then
      # Must be a directory, not a symlink
      if [ -L "$SCR_TMPDIR" ] || [ ! -d "$SCR_TMPDIR" ]; then
        echo "WARNING: $SCR_TMPDIR is not a valid directory, removing..." >&2
        if ! rm -rf "$SCR_TMPDIR"; then
          echo "ERROR: could not delete $SCR_TMPDIR" >&2
          tmpdir_ok=0
        fi
      fi
    fi
    # -m 755 rather than relying on the umask: a permissive umask would otherwise
    # leave this directory writable by everyone, and everything below is either
    # executed or sourced
    if [ $tmpdir_ok = 1 -a ! -d "$SCR_TMPDIR" ]; then
      if ! mkdir -m 755 -p "$SCR_TMPDIR" 2>/dev/null; then
        echo "ERROR: could not create $SCR_TMPDIR" >&2
        tmpdir_ok=0
      fi
    fi
    if [ $tmpdir_ok = 1 ] && ! -check-tmpdir "$SCR_TMPDIR"; then
      tmpdir_ok=0
    fi
    if [ $tmpdir_ok = 1 -a ! -d $SCR_TMPDIR/bin ]; then
      if ! mkdir -m 755 -p $SCR_TMPDIR/bin 2>/dev/null; then
        echo "ERROR: could not create $SCR_TMPDIR/bin" >&2
        tmpdir_ok=0
      fi
    fi
    if [ $tmpdir_ok = 0 ]; then
      # $EDITOR, $GIT_SSH and $SCR_SSH_PROXY_JUMP name executables and
      # $SCR_SCREENRC a file that gets sourced, so they are cleared rather than
      # aimed at a directory we did not create (or refused to trust). what is left
      # is a working bash shell with every scrash function in it, and a vim that
      # still gets its whole configuration -- that arrives on a file descriptor and
      # never needed a file. most everything else here is compromised
      unset EDITOR SCR_SCREENRC GIT_SSH SCR_SSH_PROXY_JUMP
      echo "WARNING: scrash is running without $SCR_TMPDIR: no \$EDITOR wrapper (so no clipboard integration under sudoedit), no screenrc, no git over ssh" >&2
    fi
    version_file="$SCR_TMPDIR/.version"
    if [ $tmpdir_ok = 1 -a "$start" ]; then
      if [ ! -f "$version_file" ]; then
        -tty-echo "force clear cache now, no version file exists ($version_file)"
        clear_cache=1
      else
        old_version=$(<"$version_file")
        if [ "$old_version" != $SCR_VERSION ]; then
          -tty-echo "force clear cache now, detected scrash version change (old=$old_version, new=$SCR_VERSION)"
          clear_cache=1
          rm -f "$version_file"
        fi
      fi
    fi
    if [ $tmpdir_ok = 1 -a $clear_cache = 1 ]; then
      -clear-cache
    fi
    if [ $tmpdir_ok = 1 -a ! -f "$version_file" ]; then
      echo $SCR_VERSION > "$version_file"
    fi
    if [ "$GIT_SSH" -a ! -f "$GIT_SSH" ]; then
      {
        echo '#!/usr/bin/env bash'
        echo 'for opt in "$@"; do'
        echo '  if [ "$opt" = -G ]; then'
        echo '    exec ssh "$@"'
        echo '  fi'
        echo 'done'
        echo '-sxx-init exec ssh "$@"'
      } > $GIT_SSH
      chmod 755 $GIT_SSH
    fi
    f="$SCR_TMPDIR/psqlrc"
    if [ $tmpdir_ok = 1 ] && declare -f -- -psqlrc >/dev/null && [ ! -f "$f" ]; then
      -psqlrc >"$f"
      export PSQLRC="$f"
    fi
  fi
  if [ "$(type -t -- -bashrc)" = function ]; then
    eval -- "$(-bashrc)"
  fi
  fcns=($(compgen -A function "-") screen ssh vim ssh-add scp sftp)
  if [ $declare_mode = 1 ]; then
    declare -f -- ${fcns[*]}
    return
  fi
  export -f -- ${fcns[*]}
  if [ "$start" ]; then
    if [ "$start" = 1 ]; then
      exec bash --norc --noprofile
    else
      exec bash -c -- "-ssh-deserialize-cmd $start"
    fi
  fi
}

# sudo shortcut
# usage: arg1 is the user we want to become (default=root), remaining args are
# the command we want to run as that user
# -s
# -s nobody
# -s nobody whoami
-s() {
  local user=${1:-root} bootstr
  [ $# -gt 0 ] && shift
  [ "$STY" ] && -screen-env
  bootstr=$(-shell-boot-string -p $SCR_PORT -- "$@")
  if [ "$EDITOR" -a ! -e "$EDITOR" ]; then
    # create the editor, might need it under sudo and sudo user will not be
    # able to create it
    vim --version >/dev/null
  fi
  # we pass along STY so that -ws calls can properly detect when to run
  # -screen-env
  sudo -H -u $user bash -c "STY='$STY' $bootstr"
}

-ssh-serialize-cmd() {
  local c=("$@")
  declare -p c | openssl enc -a -A
}

-ssh-deserialize-cmd() {
  # b64 is assumed to have been generated from -ssh-serialize-cmd
  local b64="$1" c
  eval -- "$(echo -n $b64 | openssl enc -d -a -A)"
  if [[ "${c[@]}" =~ \$ ]]; then
    # may need to revisit this...
    #eval -- "${c[@]}"
    "${c[@]}"
  else
    "${c[@]}"
  fi
}

-shell-boot-string() {
  local remote_port ssh_level=$SCR_SSH_LEVEL start opts="p:l:" opt OPTIND curl_host=127.0.0.1
  while builtin getopts $opts opt; do
    case $opt in
      (p) remote_port=$OPTARG
        ;;
      (l) ssh_level=$OPTARG
        ;;
    esac
  done
  shift $(($OPTIND-1))
  if [ $# -gt 0 ]; then
    start=$(-ssh-serialize-cmd "$@")
  else
    start=1
  fi
  local base_path="/scr-get-bash-functions"
  # this credential goes into the remote command line (see below), so do not sign
  # with our own key: mint a session key for the shell we are about to start. the
  # server hands that same key back in the response, so the far end can sign with
  # it and derive its own children, and a credential taken out of the command
  # line buys one session instead of the master seed
  local session sid session_key auth_header resp_key
  session=($(-mint-session-key))
  sid=${session[0]}
  session_key=${session[1]}
  auth_header=$(-scr-auth-header "GET" "$base_path" "$sid" "$session_key")
  # the remote shell evals whatever answers on that port, so hand it a key to
  # check the response with first. the key is derived from this request's
  # timestamp and nonce (Server.js #responseKey derives the same one), so the
  # remote command line carries a single-nonce verification key and never a
  # signing key.
  #
  # note the Authorization header below is still on the remote command line:
  # this string *is* the remote command, and there is nowhere else to put it
  # before the remote shell exists. it is consumed by the curl it starts, the
  # nonce is single-use, and -shell-init execs at the end of boot (which replaces
  # this argv), so the exposure is the moment between ssh starting the shell and
  # curl finishing -- and what is exposed is one session's key
  if ! [[ "$auth_header" =~ t=([0-9]+),n=([a-f0-9]+) ]]; then
    echo "$FUNCNAME: could not parse auth header" >&2
    return 1
  fi
  resp_key=$(-hmac-sha256 "response:${BASH_REMATCH[1]}:${BASH_REMATCH[2]}" "$session_key")

  printf 'eval -- "$(r=$(NO_PROXY=%s curl -Sfs --compressed -H \"Authorization: %s\" http://%s:%s/scr-get-bash-functions?platform=$(uname)\&hostname=$(hostname)\&start=%s\&ssh_level=%s); s=$(printf %%s \"$r\" | head -n 1); b=$(printf %%s \"$r\" | tail -n +2); m=$(printf %%s \"$b\" | openssl dgst -sha256 -hmac %s); [ \"${s##*=}\" = \"${m##*= }\" ] && printf %%s \"$b\" || echo false)"' \
    "$curl_host" \
    "$auth_header" \
    "$curl_host" \
    "$remote_port" \
    "$start" \
    "$ssh_level" \
    "$resp_key"
}

