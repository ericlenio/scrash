    VM_UBUNTU_MAJOR_VERSION=$(get_ubuntu_version $VM_UBUNTU_CODENAME)
    VM_DISK_URL=https://cloud-images.ubuntu.com/releases/$VM_UBUNTU_CODENAME/release/ubuntu-$VM_UBUNTU_MAJOR_VERSION.04-server-cloudimg-${DEB_ARCH}.img
    for((i=0;i<${#VM_CODENAMES[@]};i++)); do
      if [ ${VM_CODENAMES[$i]} = $VM_UBUNTU_CODENAME -a "${VM_DISK_URLS[$i]}" ]; then
        VM_DISK_URL=${VM_DISK_URLS[$i]}
        break
      fi
    done
    VM_SUBNET=192.168.64.0/24
    case $VM_UBUNTU_CODENAME in
      (trusty)
        TOMCAT_VERSION=7
        VM_IF_NAME=eth0
        ;;
      (*)
        case $VM_UBUNTU_CODENAME in
          (xenial)
            TOMCAT_VERSION=8
            ;;
          (*)
            TOMCAT_VERSION=9
            ;;
        esac
        if [ $VM_ARCH = x64 ]; then
          VM_IF_NAME=enp0s2
        else
          VM_IF_NAME=enp0s1
        fi
        ;;
    esac
    if [ $INSTALL_LINCDOC = 1 ]; then
      VM_EXTRA_PACKAGES+=(tomcat$TOMCAT_VERSION tomcat${TOMCAT_VERSION}-admin postgresql)
    fi
    VM_STATIC_IP=$(get_static_ip $VM_UBUNTU_CODENAME)
    VM_DEFAULT_ROUTE=192.168.64.1
    VM_DNS_SERVER=192.168.105.1
    VM_NAME=q-$VM_UBUNTU_CODENAME-$VM_ARCH
    VM_WORK_DIR=$TART_HOME/vms/$VM_NAME
    for d in $VM_CACHE_DIR $VM_WORK_DIR; do
      [ -d $d ] || mkdir -p $d
    done
    VM_CLOUD_INIT_USER_DATA=$VM_WORK_DIR/user-data
    VM_CLOUD_INIT_META_DATA=$VM_WORK_DIR/meta-data
    VM_CLOUD_INIT_VENDOR_DATA=$VM_WORK_DIR/vendor-data
    VM_CLOUD_NETWORK_CONFIG=$VM_WORK_DIR/network-config
    VM_LINCDOC_WAR=$VM_WORK_DIR/$LD_CONTEXT-$VM_LINCDOC_BRANCH.war
    VM_LOCALDS=$VM_WORK_DIR/seed.img
    VM_MAC_ADDR=$VM_WORK_DIR/mac-address
    VM_DISK=$VM_WORK_DIR/disk.img
    VM_DISK_CACHED=$VM_CACHE_DIR/${VM_DISK_URL##*/}
    echo "building $VM_NAME ..."
    echo "work directory: $VM_WORK_DIR"
    echo "architecture: $VM_ARCH"
    echo "RAM MB: $VM_RAM"
    if [ $USE_DHCP = 1 ]; then
      echo "IP address: DHCP"
    else
      echo "IP address: $VM_STATIC_IP"
    fi
    echo "disk size (GB): $VM_DISK_SIZE_GB"
    echo "extra packages: ${VM_EXTRA_PACKAGES[*]}"
    if [ $INSTALL_LINCDOC = 1 ]; then
      echo "LincDoc branch to be installed: $VM_LINCDOC_BRANCH"
    fi
    echo "headless mode: $([ $HEADLESS_MODE = 0 ] && echo no || echo yes)"

    read -p "clean out work dir first (y)? " ans
    if [ -z "$ans" -o "$ans" = y ]; then
      if vm_exists $VM_NAME; then
        echo "deleting old instance of $VM_NAME"
        tart delete $VM_NAME
      fi
      rm -f $VM_WORK_DIR/*
    fi

    if ! tart list | grep -q "^$VM_NAME "; then
      echo "creating empty Linux VM structure..."
      tart create --linux "$VM_NAME"
      rm -f $VM_DISK
    fi

    if [ ! -f $VM_DISK_CACHED ]; then
      curl -L -o $VM_DISK_CACHED $VM_DISK_URL
    fi

    if [ ! -f $VM_DISK ]; then
      echo "generating fresh disk image $VM_DISK ..."
      qemu-img convert -f qcow2 -O raw $VM_DISK_CACHED $VM_DISK
      disk_size=$(get_disk_size $VM_DISK)
      if [ $disk_size -lt $VM_DISK_SIZE_GB ]; then
        qemu-img resize -f $VM_DISK_TYPE $VM_DISK ${VM_DISK_SIZE_GB}G
      fi
    fi

    case $VM_UBUNTU_CODENAME in
      (trusty|xenial)
        create_user_data_legacy
        ;;
      (*)
        create_user_data
        ;;
    esac
    create_meta_data
    create_vendor_data
    create_network_config
    create_localds
    tart set $VM_NAME --memory $VM_RAM
    VM_EXEC+=(
      --root-disk-opts "caching=cached,sync=none"
      --disk "$VM_LOCALDS"
      "${VM_DISPLAY[@]}"
      "$VM_NAME"
    )
  }

  init "$@"

  if [ "$HEADLESS_MODE" = 1 ]; then
    echo "daemonizing ..."
    cd /
    nohup "${VM_EXEC[@]}" </dev/null >"$VM_WORK_DIR/tart-console.log" 2>&1 &
    VM_PID=$!
    echo "$VM_NAME is running in the background with PID: $VM_PID"
    echo "To view the console logs: tail -f $VM_WORK_DIR/tart-console.log"
  else
    exec "${VM_EXEC[@]}"
  fi
)
