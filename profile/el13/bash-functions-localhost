-ssh-askpass() {
  # passphrase_question looks like this:
  #   Enter passphrase for /Users/el13/.ssh/lenio-id_rsa: 
  local state_file="$1" passphrase_question="$2" key
  echo "$passphrase_question" >/dev/tty
  if [[ "$passphrase_question" =~ (/[-\._/[:alnum:]]+) ]]; then
    key=$(basename "${BASH_REMATCH[1]}")
    if fgrep -q "$key" $state_file; then
      return 1
    fi
    -pw "$key"
    echo "$key" >> $state_file
  else
    echo "$FUNCNAME: could not parse ssh key from string: $passphrase_question" >&2
    return 1
  fi
}

-ssh-load-keys() {
  # state_file will track which passphrases have been asked for, and if asked
  # more than once for any given key we need to short circuit ssh-add to fail
  # (and not keep repeatedly invoking $SSH_ASKPASS for the passphrase)
  local SSH_ASKPASS=$(mktemp) key keys otp i state_file=$(mktemp)
  IFS=$'\n' read -d '' -a keys <<<"$(-pw -i 1 SSHKEY)" || true
  if [ ${#keys[*]} -eq 0 ]; then
    echo "$FUNCNAME: unable to load list of ssh keys" >&2
    return 1
  fi
  for ((i=0;i<${#keys[@]};i++)); do
    # resolve any tildes in the filename
    keys[$i]="${keys[$i]/#\~/$HOME}"
  done
  printf '#!/usr/bin/env bash\nset -e\n-ssh-askpass %s "$@"\n' $state_file >$SSH_ASKPASS
  chmod +x $SSH_ASKPASS
  trap "rm -f $SSH_ASKPASS $state_file" RETURN
  if SSH_ASKPASS_REQUIRE=force SSH_ASKPASS=$SSH_ASKPASS ssh-add "${keys[@]}" </dev/null; then
    echo SUCCESS
  else
    echo FAIL
  fi
}

-ld-crypt() {
  local groovy=$(mktemp)
  cat > $groovy <<'EOF'
#! /usr/bin/env groovy
