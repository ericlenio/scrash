}

# trade the profile's IAM user keys for a federated console sign-in URL, so
# the browser goes straight to destination_url without a password prompt.
# The policy below grants nothing extra: a federated session gets only the
# intersection of it and the IAM user's own permissions.
-aws-console-signin-url() {
  local aws_profile=$1 destination_url=$2 creds session resp signin_token destination
  creds=$(aws sts get-federation-token --profile "$aws_profile" \
    --name "${USER:-scrash}" \
    --policy '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":"*","Resource":"*"}]}' \
    --output json)
  session=$(jq -c '{sessionId:.Credentials.AccessKeyId,sessionKey:.Credentials.SecretAccessKey,sessionToken:.Credentials.SessionToken}' <<<"$creds")
  resp=$(curl -sSf --get https://signin.aws.amazon.com/federation \
    --data-urlencode Action=getSigninToken --data-urlencode "Session=$session")
  signin_token=$(jq -r '.SigninToken // empty' <<<"$resp")
  if [ -z "$signin_token" ]; then
    echo "$FUNCNAME: no sign-in token from AWS federation endpoint" >&2
    return 1
  fi
  destination=$(jq -rn --arg u "$destination_url" '$u|@uri')
  echo "https://signin.aws.amazon.com/federation?Action=login&Issuer=scrash&Destination=$destination&SigninToken=$signin_token"
}

-ec2() (
  set -e
  local aws_profile=lincware

  usage() {
    echo "usage: ${FUNCNAME[2]} [-h][-d][-p profile]
simple front end for LincWare AWS EC2 operations
-h: this help
-p: specify a particular AWS CLI profile (default=$aws_profile)
-d: pass --dry-run flag to ec2 command

set up ~/.aws/config (or set AWS_DEFAULT_OUTPUT, AWS_DEFAULT_REGION):
  [client_identifier]
  output = json
  region = us-east-1

and ~/.aws/credentials (or set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY):
  [client_identifier]
  aws_access_key_id = AKIAXXXXXXXXXXXXXXXX
  aws_secret_access_key = XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
"
  }

  local VM_INSTANCE_DATA=() VM_INSTANCE_IDX dry_run=0 \
    AWS_DEFAULT_REGION=us-east-1 \
    AWS_PAGER=$PAGER \
    VM_INSTANCE_VARS=(
      # this list should match up with the query in fetch_instance_data
      instance_name
      instance_id
      instance_type
      instance_state 
      private_ip
    ) VM_MENU_CHOICES=(
      "console_output VM_INSTANCE_ID" 
      "console_screenshot VM_INSTANCE_ID" 
      "edit_instance_in_browser VM_INSTANCE_ID"
      "reboot VM_INSTANCE_ID"
      "serial_console VM_INSTANCE_ID"
      "ssh_root VM_INSTANCE_ID"
      "start VM_INSTANCE_ID" 
      "status" 
      "stop VM_INSTANCE_ID" 
    )

  fetch_instance_data() {
    local i
    [ ${#VM_INSTANCE_DATA[@]} -gt 0 ] && return
    #aws ec2 describe-instances --filters Name=tag:Name,Values=ai2 --query 'Reservations[*].Instances[*].[InstanceId]' --output text
    IFS=$'\n' read -d '' -a VM_INSTANCE_DATA <<< "$(aws ec2 describe-instances --profile $aws_profile --query 'Reservations[].Instances[].[Tags[?Key==`Name`].Value|[0],InstanceId,InstanceType,State.Name,PrivateIpAddress]' --output text | sort -f)" || true
    for((i=0;i<${#VM_INSTANCE_DATA[@]};i++)); do
      VM_INSTANCE_DATA[$i]=$(printf "%-24s %-20s %-12s %-12s %s" ${VM_INSTANCE_DATA[$i]})
    done
    echo "loaded ${#VM_INSTANCE_DATA[*]} rows of VM instance data" >&2
  }

  get_instance_info() {
    local instance_idx=$1 varname=$2 i instance_info
    for((i=0;i<${#VM_INSTANCE_VARS[*]};i++)); do
      if [ ${VM_INSTANCE_VARS[$i]} = $varname ]; then
        read -d '' -a instance_info <<< "${VM_INSTANCE_DATA[$instance_idx]}" || true
        echo "${instance_info[$i]}"
        return
      fi
    done
    echo "$FUNCNAME: failed to find value for varname=$varname" >&2
    return 1
  }

  get_instance_id() {
    get_instance_info "$@" ${FUNCNAME:4}
  }

  get_instance_name() {
    get_instance_info "$@" ${FUNCNAME:4}
  }

  get_instance_state() {
    get_instance_info "$@" ${FUNCNAME:4}
  }

  get_private_ip() {
    get_instance_info "$@" ${FUNCNAME:4}
  }

  pick_instance_id() {
    local fcn=$1 choice PS3
    fetch_instance_data
    PS3="which VM to perform \"$fcn\" (1-${#VM_INSTANCE_DATA[@]})? "
    select choice in "${VM_INSTANCE_DATA[@]}"; do
      VM_INSTANCE_IDX=$(($REPLY-1))
      return 0
    done
    return 1
  }

  start() {
    ec2_instance_cmd $FUNCNAME start-instances "$@"
  }

  stop() {
    ec2_instance_cmd $FUNCNAME stop-instances "$@"
  }

  reboot() {
    ec2_instance_cmd $FUNCNAME reboot-instances "$@"
  }

  console_output() {
    ec2_instance_cmd $FUNCNAME get-console-output "$@"
  }

  console_screenshot() {
    ec2_instance_cmd $FUNCNAME get-console-screenshot "$@"
  }

  ssh_root() {
    local instance_idx=$1 ip
    ip=$(get_private_ip $instance_idx)
    ssh root@$ip
  }

  # interactive EC2 serial console: push a throwaway key (AWS honors it for 60
  # seconds) and ssh to the serial console endpoint. Needs a Nitro instance,
  # serial console access enabled for the account/region, and an OS user with
  # a password to log in at the console prompt. "~." disconnects.
  serial_console() {
    local instance_idx=$1 instance_id state enabled key_dir rc=0
    instance_id=$(get_instance_id $instance_idx)
    validate_instance_id "$instance_id"
    state=$(get_instance_state $instance_idx)
    if [ "$state" != running ]; then
      echo "$FUNCNAME: instance is $state, not running" >&2
      return 1
    fi
    enabled=$(aws ec2 get-serial-console-access-status --profile $aws_profile \
      --query SerialConsoleAccessEnabled --output text)
    if [ "$enabled" != True ]; then
      echo "$FUNCNAME: serial console access is disabled in $AWS_DEFAULT_REGION; enable it with:
  aws ec2 enable-serial-console-access --profile $aws_profile" >&2
      return 1
    fi
    if [ $dry_run = 1 ]; then
      echo "$FUNCNAME: dry run, not connecting to $instance_id"
      return
    fi
    key_dir=$(mktemp -d)
    ssh-keygen -q -t ed25519 -N '' -C scrash-serial-console -f $key_dir/key
    if aws ec2-instance-connect send-serial-console-ssh-public-key \
        --profile $aws_profile --instance-id $instance_id --serial-port 0 \
        --ssh-public-key file://$key_dir/key.pub --output text >/dev/null; then
      echo "connecting to serial console of $instance_id (\"~.\" to disconnect, press enter for a login prompt)"
      ssh -i $key_dir/key -o IdentitiesOnly=yes \
        $instance_id.port0@serial-console.ec2-instance-connect.$AWS_DEFAULT_REGION.aws || true
    else
      rc=1
    fi
    rm -rf $key_dir
    return $rc
  }

  edit_instance_in_browser() {
    local instance_idx=$1 instance_id console_url url
    instance_id=$(get_instance_id $instance_idx)
    printf -v console_url "https://%s.console.aws.amazon.com/ec2/home?region=%s#InstanceDetails:instanceId=%s" $AWS_DEFAULT_REGION $AWS_DEFAULT_REGION $instance_id
    url=$(-aws-console-signin-url $aws_profile "$console_url")
    printf %s "$url" | -set-clipboard
    echo "sign-in URL is copied to clipboard (single use, valid 15 minutes, lands on $console_url)"
  }

  ec2_instance_cmd() {
    local cmd=$1 ec2_cmd=$2 instance_idx=$3 aws_cmd instance_id ans
    instance_id=$(get_instance_id $instance_idx)
    validate_instance_id "$instance_id"
    aws_cmd=(aws ec2 --profile $aws_profile $ec2_cmd)
    [ $dry_run = 1 ] && aws_cmd+=(--dry-run)
    case $ec2_cmd in
      (get-console-*) aws_cmd+=(--instance-id)
        ;;
      (*) aws_cmd+=(--instance-ids)
        ;;
    esac
    aws_cmd+=($instance_id)
    echo "${aws_cmd[*]}"
    read -p "enter \"y\" to run the above command: " ans
    if [ "$ans" = y ]; then
      "${aws_cmd[@]}"
    fi
  }

  validate_instance_id() {
    local instance_id=$1
    if [ ${#instance_id} -eq 0 ]; then
      echo "$FUNCNAME: blank instance ID" >&2
      return 1
    fi
    if ! [[ "$instance_id" =~ ^i-[[:alnum:]]{17}$ ]]; then
      echo "$FUNCNAME: invalid instance ID: $instance_id" >&2
      return 1
    fi
  }

  status() {
    fetch_instance_data
    for line in "${VM_INSTANCE_DATA[@]}"; do
      echo "$line"
    done
  }

  confirm() {
    local ans random=$(($RANDOM % 10))$(($RANDOM % 10)) fcn=$1 instance_idx=$2
    local instance_name=$(get_instance_name $instance_idx)
    echo "Proceed with the following command:"
    printf "%s %s\n" $fcn $instance_name
    read -p "type \"$random\" to confirm: " ans
    if [ "$ans" != $random ]; then
      return 1
    fi
  }

  main() {
    local opt opts=hdp: OPTIND choice fcn_array fcn fcn_args n_fcn_args i arg instance_idx PS3
    while builtin getopts $opts opt; do
      case $opt in
        (h) usage
          return
          ;;
        (p) aws_profile=$OPTARG
          ;;
        (d) dry_run=1
          ;;
      esac
    done
    # use the profile's own region (e.g., ohana is us-west-2) so the console
    # URLs match the instances the CLI lists
    AWS_DEFAULT_REGION=$(aws configure get region --profile $aws_profile || true)
    AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION:-us-east-1}
    PS3="choose an operation (1-${#VM_MENU_CHOICES[@]}): "
    select choice in "${VM_MENU_CHOICES[@]}"; do
      fcn_array=($choice)
      fcn=${fcn_array[0]}
      fcn_args=("${fcn_array[@]:1}")
      n_fcn_args=${#fcn_args[@]}
      for((i=0;i<$n_fcn_args;i++)); do
        arg=${fcn_args[$i]}
        case $arg in
          (VM_INSTANCE_ID)
            if ! pick_instance_id $fcn; then
              continue 2
            fi
            if ! confirm $fcn $VM_INSTANCE_IDX; then
              continue 2
            fi
            fcn_args[$i]=$VM_INSTANCE_IDX
            ;;
        esac
      done
      $fcn "${fcn_args[@]}"
    done
  }

  main "$@"
)

-rds() (
  set -e
  local aws_profile=lincware

  usage() {
    echo "usage: ${FUNCNAME[2]} [-h][-p profile][-t window][-m db_id [-w]]
simple front end for LincWare AWS RDS instances
-h: this help
-p: specify a particular AWS CLI profile (default=$aws_profile)
-t: how far back metrics, top_sql and events look: Nm, Nh or Nd (default=$window)
-m: skip the menu and print the metrics for db_id
-w: with -m, redraw the metrics every minute until interrupted; RDS
    publishes its metrics once a minute, so refreshing faster shows nothing new

Uses the same ~/.aws/config and ~/.aws/credentials setup as -ec2."
  }

  local DB_DATA=() DB_MENU=() DB_IDX region window=3h window_s period_s \
    AWS_PAGER= \
    DB_VARS=(
      # this list should match up with the query in fetch_db_data
      db_id
      engine
      engine_version
      db_class
      db_status
      allocated_gib
      dbi_resource_id
    ) DB_MENU_CHOICES=(
      "edit_db_in_browser DB_ID"
      "events DB_ID"
      "live_load DB_ID"
      "metrics DB_ID"
      "modify_db_in_browser DB_ID"
      "status"
      "top_sql DB_ID"
    ) RDS_METRICS=(
      # CloudWatch metric name:label:unit -- rows with no data are skipped, so
      # e.g. ReplicaLag only shows on replicas and BurstBalance only on gp2
      "CPUUtilization:CPU %:pct"
      "DBLoad:DB load (AAS):num"
      "DBLoadCPU:  on CPU:num"
      "DBLoadNonCPU:  waiting:num"
      "DatabaseConnections:connections:num"
      "FreeableMemory:freeable memory:bytes"
      "SwapUsage:swap used:bytes"
      "FreeStorageSpace:free storage:bytes"
      "ReadIOPS:read IOPS:num"
      "WriteIOPS:write IOPS:num"
      "ReadLatency:read latency ms:ms"
      "WriteLatency:write latency ms:ms"
      "DiskQueueDepth:disk queue depth:num"
      "ReadThroughput:read throughput:bps"
      "WriteThroughput:write throughput:bps"
      "NetworkReceiveThroughput:network in:bps"
      "NetworkTransmitThroughput:network out:bps"
      "ReplicaLag:replica lag s:num"
      "BurstBalance:burst balance %:pct"
      "CPUCreditBalance:CPU credits:num"
    ) red= yellow= reset= spark_colors=()

  rds_aws() {
    aws --profile $aws_profile --region $region "$@"
  }

  fetch_db_data() {
    local i
    [ ${#DB_DATA[@]} -gt 0 ] && return
    IFS=$'\n' read -d '' -a DB_DATA <<< "$(rds_aws rds describe-db-instances --query 'DBInstances[].[DBInstanceIdentifier,Engine,EngineVersion,DBInstanceClass,DBInstanceStatus,AllocatedStorage,DbiResourceId]' --output text | sort -f)" || true
    for((i=0;i<${#DB_DATA[@]};i++)); do
      DB_MENU[$i]=$(printf "%-28s %-10s %-8s %-16s %-12s %sG" \
        $(get_db_info $i db_id) $(get_db_info $i engine) $(get_db_info $i engine_version) \
        $(get_db_info $i db_class) $(get_db_info $i db_status) $(get_db_info $i allocated_gib))
    done
    echo "loaded ${#DB_DATA[*]} rows of RDS instance data" >&2
  }

  get_db_info() {
    local db_idx=$1 varname=$2 i db_info
    for((i=0;i<${#DB_VARS[*]};i++)); do
      if [ ${DB_VARS[$i]} = $varname ]; then
        read -d '' -a db_info <<< "${DB_DATA[$db_idx]}" || true
        echo "${db_info[$i]}"
        return
      fi
    done
    echo "$FUNCNAME: failed to find value for varname=$varname" >&2
    return 1
  }

  pick_db() {
    local fcn=$1 choice PS3
    fetch_db_data
    PS3="which DB to perform \"$fcn\" (1-${#DB_MENU[@]})? "
    select choice in "${DB_MENU[@]}"; do
      DB_IDX=$(($REPLY-1))
      return 0
    done
    return 1
  }

  find_db() {
    local db_id=$1 i
    fetch_db_data
    for((i=0;i<${#DB_DATA[@]};i++)); do
      if [ "$(get_db_info $i db_id)" = "$db_id" ]; then
        DB_IDX=$i
        return
      fi
    done
    echo "$FUNCNAME: no RDS instance \"$db_id\" in profile $aws_profile" >&2
    return 1
  }

  # parse -t (e.g. 90m, 3h, 2d) and pick a period that gives ~36 points,
  # which keeps the sparklines narrow. CloudWatch periods over 60s must be
  # a multiple of 60.
  parse_window() {
    local n
    if ! [[ $window =~ ^([0-9]+)([mhd])$ ]] || [ ${BASH_REMATCH[1]} -eq 0 ]; then
      echo "$FUNCNAME: bad window \"$window\", expected e.g. 90m, 3h or 2d" >&2
      return 1
    fi
    n=${BASH_REMATCH[1]}
    case ${BASH_REMATCH[2]} in
      (m) window_s=$((n*60)) ;;
      (h) window_s=$((n*3600)) ;;
      (d) window_s=$((n*86400)) ;;
    esac
    period_s=$(( (window_s/36 + 59) / 60 * 60 ))
  }

  open_console() {
    local db_idx=$1 fragment=$2 db_id console_url url
    db_id=$(get_db_info $db_idx db_id)
    printf -v console_url "https://%s.console.aws.amazon.com/rds/home?region=%s#$fragment" $region $region $db_id
    url=$(-aws-console-signin-url $aws_profile "$console_url")
    printf %s "$url" | -set-clipboard
    echo "sign-in URL is copied to clipboard (single use, valid 15 minutes, lands on $console_url)"
  }

  edit_db_in_browser() {
    open_console $1 'database:id=%s;is-cluster=false'
  }

  modify_db_in_browser() {
    open_console $1 'modify-instance:id=%s'
  }

  status() {
    fetch_db_data
    for line in "${DB_MENU[@]}"; do
      echo "$line"
    done
  }

  events() {
    local db_idx=$1 db_id minutes
    db_id=$(get_db_info $db_idx db_id)
    # describe-events only goes back 14 days
    minutes=$((window_s/60))
    [ $minutes -gt 20160 ] && minutes=20160
    rds_aws rds describe-events --source-type db-instance --source-identifier $db_id \
      --duration $minutes --query 'Events[].[Date,Message]' --output text \
      | sed 's/\.[0-9]*+00:00/Z/' | grep . || echo "no events for $db_id in the last $window"
  }

  # Performance Insights: where the load came from over the window, by wait
  # event and by SQL statement. Load is in average active sessions, the same
  # unit as DBLoad in metrics.
  top_sql() {
    local db_idx=$1 db_id dbi end cols
    db_id=$(get_db_info $db_idx db_id)
    dbi=$(get_db_info $db_idx dbi_resource_id)
    end=$(date +%s)
    cols=$(tput cols 2>/dev/null || echo 120)
    pi_top() {
      rds_aws pi describe-dimension-keys --service-type RDS --identifier $dbi \
        --start-time $((end-window_s)) --end-time $end --metric db.load.avg \
        --group-by "{\"Group\":\"$1\",\"Limit\":10}" --output json \
        | jq -r --arg dim "$2" --argjson w $((cols-9)) \
          '.Keys[] | "\(.Total)\t\(.Dimensions[$dim] | gsub("\\s+"; " ") | ltrimstr(" ") | .[0:$w])"' \
        | while IFS=$'\t' read -r load text; do
            printf "  %5.2f  %s\n" $load "$text"
          done
    }
    echo "$db_id: top wait events, avg active sessions over the last $window"
    pi_top db.wait_event db.wait_event.name
    echo
    echo "$db_id: top SQL, avg active sessions over the last $window"
    pi_top db.sql_tokenized db.sql_tokenized.statement
  }

  # DB load only means something next to the vCPU count: load above it is
  # sessions queueing for CPU or I/O. RDS classes are EC2 types with "db."
  # in front; print null for the odd class that is not.
  get_vcpus() {
    local db_class vcpus
    db_class=$(get_db_info $1 db_class)
    vcpus=$(rds_aws ec2 describe-instance-types --instance-types ${db_class#db.} \
      --query 'InstanceTypes[0].VCpuInfo.DefaultVCpus' --output text 2>/dev/null || true)
    [[ $vcpus =~ ^[0-9]+$ ]] || vcpus=null
    echo $vcpus
  }

  # one line every 10s with the DB load over the latest 10 seconds, from
  # Performance Insights' per-second samples, which run only ~5s behind
  # (CloudWatch's DBLoad is once a minute). Any key returns to the menu.
  live_load() {
    local db_idx=$1 db_id dbi vcpus end wait key
    db_id=$(get_db_info $db_idx db_id)
    dbi=$(get_db_info $db_idx dbi_resource_id)
    vcpus=$(get_vcpus $db_idx)
    echo "$db_id: DB load, avg active sessions per 10s against $vcpus vCPUs; press any key to stop"
    # a key rather than Ctrl-C: SIGINT reaches the whole job, and trapping it
    # here left the menu stopped (SIGTTIN) once it read the terminal again
    while :; do
      end=$(date +%s)
      rds_aws pi get-resource-metrics --service-type RDS --identifier $dbi \
        --start-time $((end-30)) --end-time $end --period-in-seconds 1 \
        --metric-queries '[{"Metric":"db.load.avg"},{"Metric":"db.load.avg","GroupBy":{"Group":"db.wait_event_type"}}]' \
        --output json \
        | jq -r --argjson vcpus $vcpus '
          def avg10: map(.Value | values) | .[-10:] | if length > 0 then add / length else null end;
          def r2: . * 100 | round / 100;
          (.MetricList | map(select(.Key.Dimensions == null))[0].DataPoints) as $total
          | ($total | avg10) as $load
          | if $load == null then "-\u001f-\u001f0\u001f\u001fno data yet" else
            [($total | map(select(.Value != null))[-1].Timestamp[11:19]),
             ($load | r2 | tostring),
             (if $vcpus == null then 0 elif $load > $vcpus then 2 elif $load > $vcpus * 0.7 then 1 else 0 end),
             (if $vcpus == null then "" else
                ([$load / $vcpus * 20 | round, 20] | min) as $n
                | ([range($n)] | map("█") | join("")) + ([range(20 - $n)] | map("░") | join("")) end),
             ([.MetricList[] | select(.Key.Dimensions != null)
               | {name: .Key.Dimensions["db.wait_event_type.name"], v: (.DataPoints | avg10)}
               | select(.v != null and .v >= 0.005)]
              | sort_by(-.v) | map("\(.name) \(.v | r2)") | join("  "))]
            | join("\u001f") end' \
        | while IFS=$'\x1f' read -r time load level bar waits; do
            case $level in (2) color=$red ;; (1) color=$yellow ;; (*) color= ;; esac
            printf "%s  %s%5s %s%s  %s\n" $time "$color" $load "$bar" "${color:+$reset}" "$waits"
          done
      wait=$((10 - ($(date +%s) - end)))
      read -s -n 1 -t $((wait > 0 ? wait : 1)) key && break
    done
  }

  # the get-metric-data queries for every metric in RDS_METRICS, at the
  # given period. Ids are m<index into RDS_METRICS>.
  metric_queries() {
    local db_id=$1 period=$2
    printf '%s\n' "${RDS_METRICS[@]}" | jq -R . | jq -sc --arg db $db_id --argjson p $period '
      to_entries | map({
        Id: "m\(.key)",
        MetricStat: {
          Metric: {Namespace: "AWS/RDS", MetricName: (.value | split(":")[0]),
                   Dimensions: [{Name: "DBInstanceIdentifier", Value: $db}]},
          Period: $p, Stat: "Average"}})'
  }

  metrics() {
    local db_idx=$1 db_id db_class end vcpus row label now avg peak note level trend color
    db_id=$(get_db_info $db_idx db_id)
    db_class=$(get_db_info $db_idx db_class)
    vcpus=$(get_vcpus $db_idx)
    end=$(date +%s)
    printf "%s  %s %s  %s  %s    last %s, %d-min points, now = latest minute, %s\n" $db_id \
      $(get_db_info $db_idx engine) $(get_db_info $db_idx engine_version) $db_class \
      $(get_db_info $db_idx db_status) $window $((period_s/60)) "$(date '+%H:%M:%S')"
    printf "%-20s %9s %9s %9s   %s\n" metric now avg peak trend
    # the window at $period_s for avg/peak/trend, then the last 10 minutes at
    # 1-minute resolution for "now", so -w redraws show the newest minute
    # rather than a 5-minute (or longer) average
    {
      rds_aws cloudwatch get-metric-data --start-time $((end-window_s)) --end-time $end \
        --scan-by TimestampAscending --metric-data-queries "$(metric_queries $db_id $period_s)" --output json
      rds_aws cloudwatch get-metric-data --start-time $((end-600)) --end-time $end \
        --scan-by TimestampAscending --metric-data-queries "$(metric_queries $db_id 60)" --output json
    } | jq -rs --argjson vcpus $vcpus --argjson alloc_gib $(get_db_info $db_idx allocated_gib) \
          --argjson colors "$(jq -cn '$ARGS.positional' --args "${spark_colors[@]}")" --arg reset "$reset" \
          --args '
        def r1: . * 10 | round / 10;
        def human: if . >= 1073741824 then "\(. / 1073741824 | r1)G"
          elif . >= 1048576 then "\(. / 1048576 | r1)M"
          elif . >= 1024 then "\(. / 1024 | r1)K"
          else "\(r1)" end;
        def fmt($unit): if $unit == "bytes" then human
          elif $unit == "bps" then human + "/s"
          elif $unit == "ms" then . * 1000 | r1 | tostring
          else r1 | tostring end;
        # bar heights run over [$lo, $hi], clamped. Each bar is coloured by
        # the fifth of that range it reaches, so red means above 80% -- or,
        # with $low_is_bad, below 20%.
        def spark($lo; $hi; $low_is_bad):
          map((if $hi > $lo then (. - $lo) / ($hi - $lo) else 0 end
               | if . < 0 then 0 elif . > 1 then 1 else . end) as $f
              | ([$f * 5 | floor, 4] | min | if $low_is_bad then 4 - . else . end) as $band
              | ($colors[$band] // "")
                + "▁▂▃▄▅▆▇█"[($f * 7 | round):($f * 7 | round) + 1])
          | join("") + (if $colors == [] then "" else $reset end);
        # metrics with a natural ceiling get a fixed scale, so red there
        # means high (or low) in absolute terms; the rest are scaled to their
        # own window, where red means near its peak (or trough)
        def spark_range($name; $v): if $name == "CPUUtilization" or $name == "BurstBalance" then [0, 100]
          elif ($name | startswith("DBLoad")) and $vcpus != null then [0, $vcpus]
          elif $name == "FreeStorageSpace" then [0, $alloc_gib * 1073741824]
          else [($v | min), ($v | max)] end;
        def low_is_bad($name):
          $name | IN("FreeStorageSpace", "FreeableMemory", "BurstBalance", "CPUCreditBalance");
        # 2 = red, 1 = yellow, judged on the latest point
        def level($name; $now): if $name == "CPUUtilization" then
            (if $now >= 80 then 2 elif $now >= 60 then 1 else 0 end)
          elif $name == "DBLoad" and $vcpus != null then
            (if $now > $vcpus then 2 elif $now > $vcpus * 0.7 then 1 else 0 end)
          elif $name == "FreeStorageSpace" then
            (($now / ($alloc_gib * 1073741824) * 100) as $pct
             | if $pct < 10 then 2 elif $pct < 20 then 1 else 0 end)
          else 0 end;
        def note($name; $now): if $name == "DBLoad" and $vcpus != null then "vCPUs: \($vcpus)"
          elif $name == "FreeStorageSpace" then
            "\($now / ($alloc_gib * 1073741824) * 100 | round)% of \($alloc_gib)G"
          else "" end;
        (.[1].MetricDataResults | map({(.Id): .Values[-1]}) | add) as $latest
        | .[0].MetricDataResults[] | select(.Values | length > 0)
        | ($ARGS.positional[.Id[1:] | tonumber] | split(":")) as [$name, $label, $unit]
        | .Values as $v | ($latest[.Id] // $v[-1]) as $now
        | [$label, ($now | fmt($unit)), ($v | add / length | fmt($unit)), ($v | max | fmt($unit)),
           (spark_range($name; $v) as [$lo, $hi] | $v | spark($lo; $hi; low_is_bad($name))),
           note($name; $now), level($name; $now)]
        | join("\u001f")' "${RDS_METRICS[@]}" \
      | while IFS=$'\x1f' read -r label now avg peak trend note level; do
          case $level in (2) color=$red ;; (1) color=$yellow ;; (*) color= ;; esac
          printf "%s%-20s %9s %9s %9s%s   %s  %s%s%s\n" "$color" "$label" $now $avg $peak "${color:+$reset}" \
            $trend "$color" "$note" "${color:+$reset}"
        done
  }

  main() {
    local opt opts=hp:t:m:w OPTIND choice fcn_array fcn fcn_args n_fcn_args i arg PS3 db_id watch out
    while builtin getopts $opts opt; do
      case $opt in
        (h) usage
          return
          ;;
        (p) aws_profile=$OPTARG
          ;;
        (t) window=$OPTARG
          ;;
        (m) db_id=$OPTARG
          ;;
        (w) watch=1
          ;;
        (*) usage >&2
          return 1
          ;;
      esac
    done
    parse_window
    region=$(aws configure get region --profile $aws_profile || true)
    region=${region:-us-east-1}
    if [ -t 1 ]; then
      red=$(tput setaf 1) yellow=$(tput setaf 3) reset=$(tput sgr0)
      # sparkline bars are coloured by height, lowest fifth to highest
      if [ "$(tput colors 2>/dev/null || echo 8)" -ge 256 ]; then
        spark_colors=("$(tput setaf 34)" "$(tput setaf 112)" "$(tput setaf 220)" "$(tput setaf 208)" "$(tput setaf 196)")
      else
        spark_colors=("$(tput setaf 4)" "$(tput setaf 6)" "$(tput setaf 2)" "$(tput setaf 3)" "$(tput setaf 1)")
      fi
    fi
    if [ -n "$db_id" ]; then
      find_db $db_id
      metrics $DB_IDX
      while [ -n "$watch" ] && sleep 60; do
        out=$(metrics $DB_IDX) && clear && echo "$out"
      done
      return
    fi
    PS3="choose an operation (1-${#DB_MENU_CHOICES[@]}): "
    select choice in "${DB_MENU_CHOICES[@]}"; do
      fcn_array=($choice)
      fcn=${fcn_array[0]}
      fcn_args=("${fcn_array[@]:1}")
      n_fcn_args=${#fcn_args[@]}
      for((i=0;i<$n_fcn_args;i++)); do
        arg=${fcn_args[$i]}
        case $arg in
          # every operation here is read-only, so no confirm() as in -ec2
          (DB_ID)
            if ! pick_db $fcn; then
              continue 2
            fi
            fcn_args[$i]=$DB_IDX
            ;;
        esac
      done
      $fcn "${fcn_args[@]}"
    done
  }

  main "$@"
)

