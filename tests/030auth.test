# vim:filetype=bash
-clear-cache
# Test HMAC authentication and unauthorized request rejection

# 1. Unauthenticated request without signature headers should fail with HTTP 401
if curl -f -s "http://127.0.0.1:$SCR_PORT/scr-about" 2>/dev/null; then
  echo "Expected 401 Unauthorized for unauthenticated request" >&2
  false
fi

# 2. Signed request via -ws should succeed
res=$(-ws /scr-about)
[[ "$res" =~ scrash ]]

# 3. Invalid signature should fail
ts=$(date +%s)
nc=$(openssl rand -hex 8)
if curl -f -s -H "Authorization: SCRASH-HMAC t=$ts,n=$nc,s=invalidsig" "http://127.0.0.1:$SCR_PORT/scr-about" 2>/dev/null; then
  echo "Expected 401 Unauthorized for invalid signature" >&2
  false
fi

# 4. -scr-auth-header format validation
auth_hdr=$(-scr-auth-header GET /scr-about)
[[ "$auth_hdr" =~ ^SCRASH-HMAC\ t=[0-9]+,n=[a-f0-9]{16},s=[a-f0-9]{64}$ ]]

auth_hdr_default=$(-scr-auth-header "" /scr-about)
[[ "$auth_hdr_default" =~ ^SCRASH-HMAC\ t=[0-9]+,n=[a-f0-9]{16},s=[a-f0-9]{64}$ ]]

# 5. Direct curl using -scr-auth-header should succeed
auth_hdr_direct=$(-scr-auth-header GET /scr-about)
res_direct=$(curl -f -s -H "Authorization: $auth_hdr_direct" "http://127.0.0.1:$SCR_PORT/scr-about")
[[ "$res_direct" =~ scrash ]]

# 6. Nonce reuse / replay attack should be rejected with 401
auth_hdr_replay=$(-scr-auth-header GET /scr-about)
curl -f -s -H "Authorization: $auth_hdr_replay" "http://127.0.0.1:$SCR_PORT/scr-about" >/dev/null
if curl -f -s -H "Authorization: $auth_hdr_replay" "http://127.0.0.1:$SCR_PORT/scr-about" 2>/dev/null; then
  echo "Expected 401 Unauthorized for replayed nonce" >&2
  false
fi

# 7. Method mismatch (signature for GET sent as POST) should fail with 401
auth_hdr_get=$(-scr-auth-header GET /scr-about)
if curl -f -s -X POST -H "Authorization: $auth_hdr_get" "http://127.0.0.1:$SCR_PORT/scr-about" 2>/dev/null; then
  echo "Expected 401 Unauthorized for HTTP method mismatch" >&2
  false
fi

# 8. Well-formed (valid hex, correct length) but incorrect signature should fail
# with 401. Unlike the "invalidsig" case above, this passes the header-format
# regex and exercises the constant-time signature comparison itself.
ts=$(date +%s)
nc=$(openssl rand -hex 8)
printf -v bad_sig 'f%.0s' {1..64}
if curl -f -s -H "Authorization: SCRASH-HMAC t=$ts,n=$nc,s=$bad_sig" "http://127.0.0.1:$SCR_PORT/scr-about" 2>/dev/null; then
  echo "Expected 401 Unauthorized for well-formed but incorrect signature" >&2
  false
fi

# 9. Valid-hex signature of the wrong length must be rejected cleanly as 401,
# not crash the comparison. Guards the length check before crypto.timingSafeEqual
# (which throws on mismatched buffer lengths).
ts=$(date +%s)
nc=$(openssl rand -hex 8)
short_sig=abcd
code=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: SCRASH-HMAC t=$ts,n=$nc,s=$short_sig" "http://127.0.0.1:$SCR_PORT/scr-about")
[ "$code" = 401 ]

# 10. Timestamp outside the 300s window must be rejected with 401.
old_ts=$(( $(date +%s) - 400 ))
nc=$(openssl rand -hex 8)
old_sig=$(printf '%s' "GET:/scr-about:$old_ts:$nc" | openssl dgst -sha256 -hmac "$SCR_SEED" | awk '{print $2}')
if curl -f -s -H "Authorization: SCRASH-HMAC t=$old_ts,n=$nc,s=$old_sig" "http://127.0.0.1:$SCR_PORT/scr-about" 2>/dev/null; then
  echo "Expected 401 Unauthorized for expired timestamp" >&2
  false
fi

# 11. A signature bound to /scr-about must not authorize a different path.
auth_hdr_path=$(-scr-auth-header GET /scr-about)
if curl -f -s -H "Authorization: $auth_hdr_path" "http://127.0.0.1:$SCR_PORT/scr-hello-world" 2>/dev/null; then
  echo "Expected 401 Unauthorized for path mismatch" >&2
  false
fi

# 12. The bash-functions response is signed, so the client can tell that the
# script it is about to eval came from us. The first line carries
# #SCRASH-RESP-SIG=<hmac of the rest of the body>, keyed with a per-request key
# derived from this request's timestamp and nonce (Server.js #responseKey), which
# is what -shell-boot-string hands to the remote shell instead of SCR_SEED
ts=$(date +%s)
nc=$(openssl rand -hex 8)
sig=$(-hmac-sha256 "GET:/scr-get-bash-functions:$ts:$nc")
resp_key=$(-hmac-sha256 "response:$ts:$nc")
resp=$(curl -f -s --compressed -H "Authorization: SCRASH-HMAC t=$ts,n=$nc,s=$sig" \
  "http://127.0.0.1:$SCR_PORT/scr-get-bash-functions?platform=$(uname)&hostname=$(hostname)&start=1&ssh_level=0")
sig_line=$(printf %s "$resp" | head -n 1)
body=$(printf %s "$resp" | tail -n +2)
[[ "$sig_line" =~ ^#SCRASH-RESP-SIG=[a-f0-9]{64}$ ]]
[ -n "$body" ]
[ "${sig_line##*=}" = "$(-hmac-sha256 "$body" "$resp_key")" ]
# and a body that does not match the signature has to be detectable: this is what
# stops the remote shell from eval'ing a response we did not send
[ "${sig_line##*=}" != "$(-hmac-sha256 "${body}tampered" "$resp_key")" ]
# a key derived from a different nonce must not verify either
[ "${sig_line##*=}" != "$(-hmac-sha256 "$body" "$(-hmac-sha256 "response:$ts:$(openssl rand -hex 8)")")" ]

# 13. Session keys. A request may be signed with SCR_SEED (no k=) or with a key
# derived from it through a chain of session ids named by k=; the server
# re-derives the key from the id path alone (Server.js #sessionKey), so nothing
# is registered anywhere and a remote shell never needs the master seed.
scr-signed-get() {
  # args: path session_id_path key -- echoes the http status code
  local path="$1" sid="$2" key="$3" ts=$(date +%s) nc=$(openssl rand -hex 8) sig
  sig=$(-hmac-sha256 "GET:${path}:${ts}:${nc}" "$key")
  curl -s -o /dev/null -w '%{http_code}' \
    -H "Authorization: SCRASH-HMAC ${sid:+k=$sid,}t=${ts},n=${nc},s=${sig}" \
    "http://127.0.0.1:$SCR_PORT$path"
}
sid1=$(openssl rand -hex 8)
key1=$(-hmac-sha256 "session:$sid1")
# a session key works when it names the id it was derived from
[ $(scr-signed-get /scr-about "$sid1" "$key1") = 200 ]
# and does not work under anybody else's id, nor by claiming to be the master key
[ $(scr-signed-get /scr-about "$(openssl rand -hex 8)" "$key1") = 401 ]
[ $(scr-signed-get /scr-about "" "$key1") = 401 ]
# the master key must not be usable under a session id either
[ $(scr-signed-get /scr-about "$sid1" "$SCR_SEED") = 401 ]
# a second hop chains from the first hop's key, and the server folds the path
sid2=$(openssl rand -hex 8)
key2=$(-hmac-sha256 "session:$sid2" "$key1")
[ $(scr-signed-get /scr-about "$sid1.$sid2" "$key2") = 200 ]
# a deeper key cannot be used to sign as its own parent
[ $(scr-signed-get /scr-about "$sid1" "$key2") = 401 ]
# malformed or absurdly deep id paths are rejected before any derivation
[ $(scr-signed-get /scr-about "nothex0123456789" "$key1") = 401 ]
[ $(scr-signed-get /scr-about "abc" "$key1") = 401 ]
deep=$sid1; for i in {1..8}; do deep=$deep.$(openssl rand -hex 8); done
[ $(scr-signed-get /scr-about "$deep" "$key1") = 401 ]

# 14. A boot fetched with a session key must be handed that same session key back
# -- never the master seed -- plus the id it belongs to, so the far end can sign
# and mint its own children without ever holding SCR_SEED
sid3=$(openssl rand -hex 8)
key3=$(-hmac-sha256 "session:$sid3")
ts=$(date +%s)
nc=$(openssl rand -hex 8)
sig=$(-hmac-sha256 "GET:/scr-get-bash-functions:$ts:$nc" "$key3")
resp=$(curl -f -s --compressed -H "Authorization: SCRASH-HMAC k=$sid3,t=$ts,n=$nc,s=$sig" \
  "http://127.0.0.1:$SCR_PORT/scr-get-bash-functions?platform=$(uname)&hostname=$(hostname)&start=1&ssh_level=1")
body=$(printf %s "$resp" | tail -n +2)
grep -q "SCR_SEED=\"$key3\"" <<<"$body"
grep -q "SCR_SID=$sid3 " <<<"$body"
! grep -q "$SCR_SEED" <<<"$body" || false
# and that response is signed with a key derived from the session key, not the seed
sig_line=$(printf %s "$resp" | head -n 1)
[ "${sig_line##*=}" = "$(-hmac-sha256 "$body" "$(-hmac-sha256 "response:$ts:$nc" "$key3")")" ]
[ "${sig_line##*=}" != "$(-hmac-sha256 "$body" "$(-hmac-sha256 "response:$ts:$nc")")" ]

# 15. Failed-auth rate limiter: a burst of >20 auth failures within the window
# starts returning 429 instead of 401, while a validly-signed request is still
# served (proving the limiter cannot starve a legitimate client). Kept last so
# tripping the limiter cannot perturb the strict status-code checks above.
codes=""
for i in {1..25}; do
  codes+="$(curl -s -o /dev/null -w '%{http_code} ' "http://127.0.0.1:$SCR_PORT/scr-about")"
done
[[ "$codes" =~ 429 ]]
# a validly-signed request still succeeds despite the throttle
-ws-about | grep -q scrash

export SCR_SSH_AUTH_SOCK_SKIP_OPTIMIZATION=1
if [ "$SCR_SSH_AUTH_SOCK" ]; then
  hostname=$(-ssh-scr-server hostname)
  [ "$hostname" ]
  [ "$hostname" = $(hostname) ]

  # test out -ssh-proxy-jump
  [ -f "$SCR_SSH_PROXY_JUMP" ] || ssh -V # makes sure that $SCR_SSH_PROXY_JUMP exists
  [ -f "$SCR_SSH_PROXY_JUMP" ]
  known_hosts=$SCR_TMPDIR/ssh-known-hosts
  ssh-keyscan -p $SCR_SSH_PORT $SCR_SSH_HOST,myhost >$known_hosts
  ssh_config=$SCR_TMPDIR/ssh-config
  cat > $ssh_config <<EOF
Host *
  Port $SCR_SSH_PORT
  UserKnownHostsFile $known_hosts
Host myhost
  #ProxyCommand \${SCR_SSH_PROXY_JUMP} \${SCR_SSH_HOST} $SCR_SSH_HOST:$TEST_SSHD_PORT -p $TEST_SSHD_PORT -oUserKnownHostsFile=$known_hosts
  ProxyCommand \${SCR_SSH_PROXY_JUMP} \${SCR_SSH_HOST} $SCR_SSH_HOST:%p -F $ssh_config
EOF
  u1=$(ssh -F $ssh_config myhost uname -a)
  u2=$(uname -a)
  [ "$u1" = "$u2" ]
else
  echo "WARNING $(basename $TEST_SOURCE_FILE): skipping some tests, no value for $SCR_SSH_AUTH_SOCK" >&2
fi
SCR_SSH_AUTH_SOCK_SKIP_OPTIMIZATION=0
