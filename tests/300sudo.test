# vim:filetype=bash
-s nobody -ws-hello-world | grep -q hello
[ $(-s nobody whoami) = nobody ]
echo ok | -set-clipboard
[ ok = $(-get-clipboard) ]
t1=$SCR_TMPDIR/t1
# little vim script: find line beginning with "root", select it, copy it to
# clipboard (by pressing control-c), then quit the editor
printf "/^root\015ve\003:q\015" > $t1
vim -s $t1 /etc/passwd
[ root = $(-get-clipboard) ]
rm $t1

# the boot credential must not reach a command line. -s hands the script to the
# child on a pipe, so nothing in our own ancestry -- the sudo process above all,
# whose argv outlives the boot -- may show an Authorization header or a response
# key to ps. only this chain is walked: an ssh session elsewhere on the machine
# legitimately carries one, so a machine-wide grep would be someone else's noise
ancestry=$(-s root bash -c 'p=$$
  while [ -n "$p" ] && [ "$p" -gt 1 ]; do
    ps -ww -o args= -p $p || break
    p=$(ps -o ppid= -p $p | tr -d "[:space:]")
  done')
[[ $ancestry = *sudo* ]]
[[ $ancestry != *SCRASH-HMAC* ]]
[[ $ancestry != *-hmac* ]]

# -s hands the caller's terminal to the child as $SCR_TTY. the child cannot work
# it out for itself: sudo may put it on a pty of its own, and /dev/tty over there
# is then that pty rather than the terminal a prompt has to reach. see -caller-tty
my_tty=$(tty)
[ -c "$my_tty" ]
[ "$my_tty" = "$(-s root bash -c 'echo $SCR_TTY')" ]
# and on the argv branch too, where stdin is a pipe rather than ours to take
[ "$my_tty" = "$(echo | -s root bash -c 'echo $SCR_TTY')" ]
# a non-root target gets the same answer. $SSH_TTY would not have worked here:
# it names a pts owned by the login user, which nobody cannot open
[ "$my_tty" = "$(-s nobody bash -c 'echo $SCR_TTY')" ]
# it survives the exec at the end of -shell-init, so a command started under -s
# sees it as well
[ "$my_tty" = "$(-s root bash -s <<< 'echo $SCR_TTY')" ]
# and -scr-tty inside that shell answers with the user's terminal rather than
# what its own descriptors say. the two are the same where sudoers has no
# "Defaults use_pty" (macos), but on a host that has it (Ubuntu 26.04) the
# descriptors name the pty sudo made and only the handed-across value is right
[ "$my_tty" = "$(-s root bash -c -- -scr-tty)" ]
unset my_tty

# -boot-env-prefix builds the assignment prefix that both -s branches put into
# the string sudo hands to root's bash -c. wrapped in literal single quotes, as
# these values used to be, one carrying a quote closed it and everything after
# ran as root. checked on the prefix rather than through -s, because a $STY that
# is not a real session id stalls the screen machinery long before a shell runs
inject_probe=$SCR_TMPDIR/inject-probe
inject_show=$SCR_TMPDIR/inject-show
rm -f $inject_probe
printf 'printf %%s "$STY:$SCR_TTY"\n' > $inject_show
hostile="x'; touch $inject_probe; :'"
inject_prefix=$(STY="$hostile" -boot-env-prefix /dev/null)
# both values arrive intact, as data ...
[ "$(bash -c "$inject_prefix bash $inject_show")" = "$hostile:/dev/null" ]
# ... and nothing of the hostile one was executed
[ ! -e $inject_probe ]
# the form this replaced really was exploitable, so the assertions above are not
# passing for some unrelated reason
bash -c "STY='$hostile' bash $inject_show" >/dev/null 2>&1 || true
[ -e $inject_probe ]
rm -f $inject_probe $inject_show
unset inject_probe inject_show hostile inject_prefix
