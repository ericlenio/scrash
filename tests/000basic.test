# vim:filetype=bash
-clear-cache
-ws-about | grep scrash
-ws-about -H "Accept: text/json" | node -r fs -e 'const s=JSON.parse(fs.readFileSync(0,"utf8"));console.log(s.appName)'
! -ws /scr-no-such-endpoint
[[ $SCR_PORT =~ ^[0-9]+$ ]]
len=100
v=$(-random-string $len)
[ $len = ${#v} ]
[ "$EDITOR" ]
-ws-hello-world | grep -q "hello world"
# make sure curl web service calls properly ignores proxies that might
# typically exist in $HOME/.curlrc
curlrc="$SCR_TMPDIR/.curlrc"
echo "proxy = http://no-such-host.example.private:8181" > "$curlrc"
CURL_HOME=$(dirname "$curlrc") bash -c -- -ws-hello-world
bootstr=$(-shell-boot-string -p $SCR_PORT hostname)
h=$(CURL_HOME=$(dirname "$curlrc") bash -c "$bootstr")
[ "$h" = $(hostname) ]

# the boot string is parsed by another shell -- root's on the sudo path, the
# login user's on the far side of an ssh -- so nothing may reach it as syntax.
# $SCR_SID is the value that used to: -mint-session-key splices it into the auth
# header verbatim and -boot-credential's regex only checks the t= and n= fields.
# it now travels base64-encoded, decoded by the shell that runs the string
boot_probe=$SCR_TMPDIR/boot-inject-probe
rm -f $boot_probe
# no spaces in the payload: one with them is truncated by the word splitting in
# -mint-session-key's "sess=($(...))", which is luck and not a defence
boot_hostile='x";id>'"$boot_probe"';:"'
bootstr_hostile=$(SCR_SID="$boot_hostile" -shell-boot-string -p $SCR_PORT hostname)
# it does not reach the string as text ...
[[ $bootstr_hostile != *"$boot_probe"* ]]
# ... and running the string executes nothing of it
bash -c "$bootstr_hostile" >/dev/null 2>&1 || true
[ ! -e $boot_probe ]
# the numbers interpolated alongside it are checked rather than trusted
! -shell-boot-string -p '1;id' hostname 2>/dev/null
! -shell-boot-string -p $SCR_PORT -l '0;id' hostname 2>/dev/null
rm -f $boot_probe
unset boot_probe boot_hostile bootstr_hostile
session_id=$(screen --generate-session-id)
[ ${#session_id} -gt 0 ]
[[ $session_id =~ ^[-[:alnum:]]+$ ]]
[ -d $SCR_TMPDIR ]
[ $SCR_ENV = test ]
# md5 testing
s="hello world"
t=$(mktemp)
[ "$t" ]
echo "$s" > $t
[ -s "$t" ]
[ $(-md5 $t) = 6f5902ac237024bdd0c176cb93063dc4 ]
[ $(echo "$s" | -md5) = 6f5902ac237024bdd0c176cb93063dc4 ]
! -md5 /no-such-file
rm $t
# ssh
-ssh-scr-server true
h=$(-ssh-scr-server hostname)
[ $h = $(hostname) ]
remote_port=$(eval $(-ssh-scr-server declare -p SCR_PORT); echo $SCR_PORT)
[ $remote_port != $SCR_PORT ]
[[ $remote_port =~ ^[0-9]+$ ]]
scr_env2=$(-ssh-scr-server bash -c 'echo $SCR_ENV')
[ "$scr_env2" = $SCR_ENV ]
scr_env2=$(-s nobody bash -c 'echo $SCR_ENV')
[ "$scr_env2" = $SCR_ENV ]
u=$(-ssh-scr-server bash -c -- "uname -a")
[ "$u" = "$(uname -a)" ]
a=$(-ssh-scr-server bash -c -- 'a=asdf;echo $a')
[ $a = asdf ]
-psg node | grep -E test.js
-psg -w node | grep -E test.js
! -psg -kp 2>/dev/null
pids=($(-psg -pw node))
[ ${#pids[@]} -gt 0 ]
for pid in ${pids[@]}; do
  [[ "$pid" =~ ^[0-9]+$ ]]
done
