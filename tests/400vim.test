# vim:filetype=bash
-clear-cache
# the vim configuration lives in the environment exactly once, as the exported
# -vimrc and -vim-plugin-* functions that -vim-config runs. the $EDITOR wrapper
# pipes it to vim on a file descriptor; nothing is written to disk, and nothing
# holds a second copy of it
scr_vim_config="$(-vim-config)"
[ ${#scr_vim_config} -gt 0 ]
# $VIMINIT must not be left set: a vim started some other way would try to source
# whatever fd 3 happens to be
[ ${#VIMINIT} = 0 ]
# matched in the shell rather than piped to grep: grep would stop reading at the
# first match and leave the gzip inside -vim-plugin-functions with a broken pipe
[[ "$scr_vim_config" = *ScrSetClipboard* ]]
# the configuration is produced verbatim, never quoted, escaped or encoded
[[ "$scr_vim_config" != *"call execute("* ]]
[ ${#EDITOR} -gt 0 ]
# every new shell gets the wrapper from -shell-init rather than from the first
# vim: a shell can go on to hand $EDITOR to something that cannot create it (sudo,
# where the target user cannot write our $SCR_TMPDIR), so it has to be there
# before any vim has run
rm -f $EDITOR
(-shell-init)
[ -e $EDITOR ]
rm -f $EDITOR
vim --version >/dev/null
[ -e $EDITOR ]
# the wrapper calls -vim-config and pipes it over a descriptor: it must not name a
# file, and must not embed the configuration in itself
[[ "$(<$EDITOR)" = *"/dev/fd/3"* ]]
[[ "$(<$EDITOR)" = *"-vim-config"* ]]
[[ "$(<$EDITOR)" != *ScrNextColorScheme* ]]
# and nothing anywhere under $SCR_TMPDIR contains the configuration
[ "$(find $SCR_TMPDIR -name '*.vim')" = "" ]
[ ! -e $SCR_TMPDIR/vimrc ]
! grep -rl ScrNextColorScheme $SCR_TMPDIR >/dev/null 2>&1
rm $EDITOR
vim --version >/dev/null
[ -e $EDITOR ]

# the config has to be *sourced*, not just executed: only a real script context
# gives script-local (s:) variables, which ScrNextColorScheme uses. running the
# lines with execute() instead leaves it throwing E461 the first time F8 is
# pressed, which nothing at startup reveals
tsrc=$SCR_TMPDIR/tsrc
tres=$SCR_TMPDIR/tres
vim -c 'call ScrNextColorScheme(1)' -c "call writefile([get(g:,'colors_name','NONE')],'$tres')" -c 'qall!' /etc/passwd
[ "$(<$tres)" != NONE ]

# sourcing a descriptor has to leave the edited file exactly as a vimrc would:
# content intact, not modified, no undo entry (or "u" in a freshly opened file
# would replace it with the text of the vimrc), and the vimrc's buffer-local
# options applied to that buffer
printf 'alpha\nbeta\n' > $tsrc
vim -c "call writefile([line('$').':'.getline(1).':'.&modified.':'.undotree().seq_last.':'.&tabstop.':'.&expandtab],'$tres')" -c 'qall!' $tsrc
[ "$(<$tres)" = "2:alpha:0:0:2:1" ]

# the profile's -edit() opens vim with "-S <(...)", so a second process
# substitution has to coexist with the one carrying the configuration
vim -S <(printf ':let g:from_S=1\n') -c "call writefile([get(g:,'from_S',-1).':'.&tabstop.':'.exists('*ScrSetClipboard')],'$tres')" -c 'qall!' $tsrc
[ "$(<$tres)" = "1:2:1" ]

echo ok | -set-clipboard
[ ok = $(-get-clipboard ) ]
t1=$SCR_TMPDIR/t1
t2=$SCR_TMPDIR/t2
t3=$SCR_TMPDIR/t3

printf "/^root\015vey:call ScrSetClipboard(@\")\015:q\015" > $t1
vim -s $t1 /etc/passwd
#'rm $t1
[ root = $(-get-clipboard) ]

s="The quick brown fox jumps over the lazy dog"
echo "$s" | -set-clipboard
[ "$s" = "$(-get-clipboard)" ]
printf ":call ScrPasteClipboard()\015ZZ" > $t1
vim -s $t1 $t2
[ -e $t2 ]
[ "$(<$t2)" = "$s" ]

# test paste in middle of a line
cp $t2 $t3
echo cat | -set-clipboard
[ cat = $(-get-clipboard) ]
printf "/fox\0153x:call ScrPasteClipboard()\015ZZ" > $t1
vim -s $t1 $t3
[ "The quick brown cat jumps over the lazy dog" = "$(<$t3)" ]

# test paste at end of a line
cp $t2 $t3
printf "$:call ScrPasteClipboard()\015ZZ" > $t1
vim -s $t1 $t3
[ "The quick brown fox jumps over the lazy dogcat" = "$(<$t3)" ]

# test pasting multiple lines
s2="line1:aa bb cc
line2"
echo "$s2" > $t3
printf -v s3 "The quick brown\nfox jumps over\nthe lazy dog"
echo "$s3" | -set-clipboard
printf "/bb\015:call ScrPasteClipboard()\015ZZ" > $t1
vim -s $t1 $t3
[ $(wc -l <$t3) = 4 ]
grep '^fox jumps over$' $t3 >/dev/null
grep '^the lazy dogbb cc$' $t3 >/dev/null
[ "$(tail -1 $t3)" = line2 ]

# the clipboard functions are inlined into $VIMINIT, so they are there without
# anything on runtimepath having been written
[ "$(find $SCR_TMPDIR -name '*.vim')" = "" ]
printf "/^root\015vey:call ScrSetClipboard(@\")\015:q\015" > $t1
vim -s $t1 /etc/passwd
#'rm $t1
[ root = $(-get-clipboard) ]
