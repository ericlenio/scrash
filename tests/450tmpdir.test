# vim:filetype=bash
# a $SCR_TMPDIR we cannot use must not stop the login: the far end of a ssh boots
# by running -shell-init, so a -shell-init that returns non-zero is an ssh that
# dies. $SCR_TMPDIR is built from $SCR_PORT_0, so overriding that in a subshell
# points -shell-init at a directory we cannot write in -- a readonly /tmp, in
# effect
ro=$(SCR_PORT_0=readonly -scr-tmpdir)
mkdir -p $ro
chmod 555 $ro
printf "\nchmod 700 %s; rmdir %s\n" $ro $ro >> "$TEST_CLEANUP_FILE"
out=$(SCR_PORT_0=readonly bash -c -- '-shell-init 2>/dev/null; echo "rc=$?[$EDITOR][$SCR_SCREENRC][$GIT_SSH][$SCR_SSH_PROXY_JUMP]"')
[ "$out" = "rc=0[][][][]" ]

# and vim with no wrapper to run is still a configured vim: the configuration
# arrives on a file descriptor, so it needs nothing on disk. ScrSetClipboard is
# defined by the vim plugins, so its presence proves the configuration was sourced
tres=$SCR_TMPDIR/tmpdir-tres
rm -f $tres
(
  unset EDITOR
  vim -c "call writefile([exists('*ScrSetClipboard')],'$tres')" -c 'qall!' /etc/passwd
)
[ "$(<$tres)" = 1 ]
rm -f $tres

# -clear-cache empties $SCR_TMPDIR but must leave the directory and its bin subdir
# standing: -shell-init calls it before writing .version and psqlrc, so a
# -clear-cache that takes the directory with it leaves the rest of the login
# writing into nothing. this is what OpenBSD did, where find(1) documents -mindepth
# as a primary ("true if the current search depth is at least n") rather than the
# global option gnu and macos make it -- the starting directory failed that test,
# fell through to the -o branch and got rm -rf'd. dotfiles have to go too
cc=/tmp/scr-$USER-$SCR_ENV-clearcache
rm -rf $cc
mkdir -p $cc/bin $cc/subdir
touch $cc/junk $cc/.dotjunk $cc/subdir/x $cc/bin/binjunk
printf "\nrm -rf %s\n" $cc >> "$TEST_CLEANUP_FILE"
(
  SCR_TMPDIR=$cc
  -clear-cache
)
[ -d $cc -a -d $cc/bin ]
[ "$(ls -A $cc)" = bin ]
[ -z "$(ls -A $cc/bin)" ]
rm -rf $cc

# on the scrash machine $SCR_TMPDIR lives under the home directory rather than in
# /tmp, where the macos tmp_cleaner takes anything left untouched for three days
# ($GIT_SSH, written once at login, was the casualty). the far end of a ssh stays
# in /tmp. and the port is part of the name either way, so that "scrash -p 3333"
# alongside a running scrash does not share a directory with it
[ "$SCR_SSH_LEVEL" = 0 ]
[ "$SCR_TMPDIR" = "$HOME/.cache/scrash/scr-$USER-$SCR_ENV-$SCR_PORT_0" ]
[ "$(SCR_SSH_LEVEL=1 -scr-tmpdir)" = "/tmp/scr-$USER-$SCR_ENV-$SCR_PORT_0" ]
[ "$(SCR_PORT_0=3333 -scr-tmpdir)" != "$SCR_TMPDIR" ]
# a name that would have to be eval'd to look up is refused rather than eval'd
! (SUDO_USER='x;touch /tmp/scr-pwned' -scr-tmpdir 2>/dev/null) || false
[ ! -e /tmp/scr-pwned ]

# a sudo'd shell has to arrive at the invoking user's directory, not one under
# the target user's home ($HOME is theirs under sudo -H)
[ "$(-s nobody printenv SCR_TMPDIR)" = "$SCR_TMPDIR" ]
# and a target user who cannot get into it -- the home directory is usually not
# open to other users -- boots without complaint: it is expected, not a fault
err=$(-s nobody true 2>&1 >/dev/null)
[[ "$err" != *"running without"* ]]
[[ "$err" != *"could not create"* ]]
# such a shell has no port to refresh inside screen either, since the port only
# changes on a reconnect, so -screen-env succeeds and leaves SCR_PORT as it was.
# -s runs -screen-env as us first, which leaves an env file for the made up
# session to clean up
ans=$(STY=1.scr-tmpd -s nobody bash -c -- '-screen-env -p; echo rc=$?' 2>/dev/null)
[ "$ans" = "$SCR_PORT"$'\n'rc=0 ]
rm -f $SCR_TMPDIR/scr-sty-env-scr-tmpd $SCR_TMPDIR/scr-sty-seed-scr-tmpd

# -clear-cache only empties a directory -scr-tmpdir could have named, which now
# includes the home directory one
cc=$HOME/.cache/scrash/scr-$USER-$SCR_ENV-clearcache
rm -rf $cc
mkdir -p $cc/bin
touch $cc/junk
printf "\nrm -rf %s\n" $cc >> "$TEST_CLEANUP_FILE"
(
  SCR_TMPDIR=$cc
  -clear-cache
)
[ "$(ls -A $cc)" = bin ]
# but not the directory they all sit in, which would take every other port's
# with it
mkdir -p $cc/keep
touch $cc/keep/x
(
  SCR_TMPDIR=$HOME/.cache/scrash/
  -clear-cache
)
[ -e $cc/keep/x ]
rm -rf $cc
unset ans err cc
