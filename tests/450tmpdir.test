# vim:filetype=bash
# a $SCR_TMPDIR we cannot use must not stop the login: the far end of a ssh boots
# by running -shell-init, so a -shell-init that returns non-zero is an ssh that
# dies. $SCR_TMPDIR is built from $SCR_PORT_0, so overriding that in a subshell
# points -shell-init at a directory we cannot write in -- a readonly /tmp, in
# effect
ro=/tmp/scr-$USER-$SCR_ENV-readonly
mkdir -p $ro
chmod 555 $ro
printf "\nchmod 700 %s; rmdir %s\n" $ro $ro >> "$TEST_CLEANUP_FILE"
out=$(SCR_PORT_0=readonly bash -c -- '-shell-init 2>/dev/null; echo "rc=$?[$EDITOR][$SCR_SCREENRC][$GIT_SSH][$SCR_SSH_PROXY_JUMP]"')
[ "$out" = "rc=0[][][][]" ]

# and vim with no wrapper to run is still a configured vim: the configuration
# arrives on a file descriptor, so it needs nothing on disk. ScrSetClipboard is
# defined by the vim plugins, so its presence proves the configuration was sourced
tres=$SCR_TMPDIR/tmpdir-tres
rm -f $tres
(
  unset EDITOR
  vim -c "call writefile([exists('*ScrSetClipboard')],'$tres')" -c 'qall!' /etc/passwd
)
[ "$(<$tres)" = 1 ]
rm -f $tres

# -clear-cache empties $SCR_TMPDIR but must leave the directory and its bin subdir
# standing: -shell-init calls it before writing .version and psqlrc, so a
# -clear-cache that takes the directory with it leaves the rest of the login
# writing into nothing. this is what OpenBSD did, where find(1) documents -mindepth
# as a primary ("true if the current search depth is at least n") rather than the
# global option gnu and macos make it -- the starting directory failed that test,
# fell through to the -o branch and got rm -rf'd. dotfiles have to go too
cc=/tmp/scr-$USER-$SCR_ENV-clearcache
rm -rf $cc
mkdir -p $cc/bin $cc/subdir
touch $cc/junk $cc/.dotjunk $cc/subdir/x $cc/bin/binjunk
printf "\nrm -rf %s\n" $cc >> "$TEST_CLEANUP_FILE"
(
  SCR_TMPDIR=$cc
  -clear-cache
)
[ -d $cc -a -d $cc/bin ]
[ "$(ls -A $cc)" = bin ]
[ -z "$(ls -A $cc/bin)" ]
rm -rf $cc
