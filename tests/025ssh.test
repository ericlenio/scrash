# vim:filetype=bash
-clear-cache
export SCR_SSH_AUTH_SOCK_SKIP_OPTIMIZATION=1
if [ "$SCR_SSH_AUTH_SOCK" ]; then
  SCR_SSH_USER_KNOWN_HOSTS=$SCR_TMPDIR/known_hosts
  echo "$SCR_SSH_HOST_KEY" >$SCR_SSH_USER_KNOWN_HOSTS
  hostname=$(ssh -p $SCR_SSH_PORT -oUserKnownHostsFile=$SCR_SSH_USER_KNOWN_HOSTS $SCR_SSH_HOST hostname)
  [ "$hostname" ]
  [ "$hostname" = $(hostname) ]

  # add in some tests around the version file
  version_file=$SCR_TMPDIR/.version
  [ -f $version_file ]
  rm $version_file
  # this next ssh session should use the same $SCR_TMPDIR, and re-create the
  # version file
  echo "$SCR_SSH_HOST_KEY" >$SCR_SSH_USER_KNOWN_HOSTS
  hostname=$(ssh -p $SCR_SSH_PORT -oUserKnownHostsFile=$SCR_SSH_USER_KNOWN_HOSTS $SCR_SSH_HOST hostname)
  [ "$hostname" = $(hostname) ]
  [ -f $version_file ]

  ssh-add -l

  # -sxx-scr-server removes its known hosts file itself now, rather than leaving it
  # to ssh's -oLocalCommand, so the status of the command it ran has to come back
  # out through that cleanup
  rc=0; -sxx-scr-server false || rc=$?
  [ $rc = 1 ]

  # "ssh -G" only resolves config, it does not connect; it must reach a plain
  # ssh (it used to drop the ssh from the command and run "env -G ..." instead).
  # skip the auth sock proxy for this one, we are only checking the command line
  SCR_SSH_AUTH_SOCK_SKIP_OPTIMIZATION=0 ssh -G $SCR_SSH_HOST | grep -q "^hostname "
  rm -f /tmp/passwd
  -download /etc/passwd
  [ -f /tmp/passwd ]
  [ $(-md5 /tmp/passwd) = $(-md5 /etc/passwd) ]
  rm /tmp/passwd

  echo "$SCR_SSH_HOST_KEY" >$SCR_SSH_USER_KNOWN_HOSTS
  ssh_cmd=(ssh -p $SCR_SSH_PORT -oUserKnownHostsFile=$SCR_SSH_USER_KNOWN_HOSTS $SCR_SSH_HOST bash -c -- -vars)
  "${ssh_cmd[@]}" | grep -q SCR_TMPDIR

  m1="should_not_see_this_string_because_exec_should_effectively_hide_it"
  t1=$SCR_TMPDIR/ssh_exec_test
  printf "#!/usr/bin/env bash\nset -e\ndeclare -f ssh >/dev/null\n%s\necho '%s'\n" "${ssh_cmd[*]}" "$m1" >$t1
  chmod 755 $t1
  $t1 | grep -q SCR_TMPDIR
  SCR_SSH_EXEC=0 $t1 | grep -q "$m1"
  ! SCR_SSH_EXEC=1 $t1 | grep -q "$m1"
else
  echo "WARNING $(basename $TEST_SOURCE_FILE): skipping some tests, no value for SCR_SSH_AUTH_SOCK" >&2
fi
SCR_SSH_AUTH_SOCK_SKIP_OPTIMIZATION=0
