# vim:filetype=bash
random_string() {
  echo $RANDOM-$RANDOM-$RANDOM-$RANDOM-$RANDOM
}

# use mktemp for SCR_PASSWORD_FILE (and not place it in $SCR_TMPDIR) so they
# survive the ssh calls below (because ssh-ing will effectively wipe the cache
# under $SCR_TMPDIR)
SCR_PASSWORD_FILE_ORIG=$SCR_PASSWORD_FILE
SCR_PASSWORD_FILE=$(mktemp -u)

add_pw() {
  local pwkey="$1" user="$2" pw="$3" new_pw_entry
  printf -v new_pw_entry "%s:%s:%s" "$pwkey" "$user" "$pw"
  -pw -a "$new_pw_entry"
}

-ssh-pw() {
  -ssh-scr-server bash -c -- '"$@"' -- -pw -p $SCR_PASSWORD_FILE "$@" </dev/null
}

# every -ssh-pw below is a remote password request, and each one has to be
# approved locally (-pw-confirm). the test double for it (see
# src/test/bash/bash-functions-test) approves while this file exists. it is next
# to $SCR_TMPDIR and not inside it for the same reason SCR_PASSWORD_FILE is
# elsewhere: ssh-ing wipes that directory
pw_approve_flag=$SCR_TMPDIR-pw-confirm-approve
touch $pw_approve_flag

! [ -s "$SCR_PASSWORD_FILE" ]
-pw -I
[ -s "$SCR_PASSWORD_FILE" ]
pwkey1="my password key with funky chars &/"
user1="testuser"
pw1=$(random_string)
add_pw "$pwkey1" "$user1" "$pw1"

pwkey2="another password key with funky chars ;'<!"
user2="testuser2"
pw2=$(random_string)
add_pw "$pwkey2" "$user2" "$pw2"

backslash_pw="\a\b\c\d"
add_pw "backslashes" "some-user" "$backslash_pw"

! -pw no-such-pw-key || false

#echo h1;gpg -d $SCR_PASSWORD_FILE;
pw=$(-pw "$pwkey1")
[ "$pw" = "$pw1" ]
user=$(-pw -i 1 "$pwkey1")
[ "$user" = "$user1" ]
user_b64=$(-pw -i 1 -b "$pwkey1")
[ $(printf %s "$user" | openssl enc -a -A) = $user_b64 ]
pwkey=$(-pw -i 0 "$pwkey1")
[ "$pwkey" = "$pwkey1" ]

[ "$backslash_pw" = "$(-pw backslashes)" ]

pw=$(-ssh-pw -i -1 "$pwkey")
[ "$pw" = "$pw1" ]
pw=$(-ssh-pw -i 2 "$pwkey")
[ "$pw" = "$pw1" ]
user=$(-ssh-pw -i 1 "$pwkey")
[ "$user" = "$user1" ]
pwkey=$(-ssh-pw -i 0 "$pwkey")
[ "$pwkey" = "$pwkey1" ]
pwkey_b64=$(-ssh-pw -i 0 -b "$pwkey")
[ $(printf %s "$pwkey" | openssl enc -a -A) = "$pwkey_b64" ]

[ $(-pw password | wc -l) -eq 2 ]
# search the password file for "password", which should be 3 hits, one of which
# is in a comment
[ $(gpg -qd $SCR_PASSWORD_FILE | grep password | wc -l) -eq 3 ]
[ "$(-pw password)" = "$pw1"$'\n'"$pw2" ]
[ "$(-pw -i -1 password)" = "$pw1"$'\n'"$pw2" ]
[ "$(-ssh-pw -i -1 password)" = "$pw1"$'\n'"$pw2" ]
[ "$(-pw -i 2 password)" = "$pw1"$'\n'"$pw2" ]
[ "$(-ssh-pw -i 2 password)" = "$pw1"$'\n'"$pw2" ]
[ "$(-pw -i 0 password)" = "$pwkey1"$'\n'"$pwkey2" ]
[ "$(-ssh-pw -i 0 password)" = "$pwkey1"$'\n'"$pwkey2" ]
[ "$(-pw -i 1 password)" = "$user1"$'\n'"$user2" ]
[ "$(-ssh-pw -i 1 password)" = "$user1"$'\n'"$user2" ]
[ "$(-ssh-pw -i 1 -b password)" = $(printf %s "$user1" | openssl enc -a -A)$'\n'$(printf %s "$user2" | openssl enc -a -A) ]

# a remote request may only ask for a lookup: the args arrive from the remote host
# and are handed back to -pw-localhost as options, so the ones that write to the
# store or open an editor in it have to be refused before -pw-confirm is even
# reached. -a needs a value, the rest do not
for remote_opt in -a -c -e -I; do
  ! -ssh-pw $remote_opt "evil:user:pw" 2>/dev/null || false
done
# the password file must be untouched by the rejected -a above
! gpg -qd $SCR_PASSWORD_FILE | grep -q evil || false

# -i lands in an arithmetic evaluation, where a subscript like a[$(cmd)] would run
# cmd. a remote caller must not get that far
pwn=$SCR_TMPDIR/pw-injection
rm -f $pwn
! -ssh-pw -i "1+a[\$(touch $pwn)]" "$pwkey1" 2>/dev/null || false
[ ! -e $pwn ]
# same guard on the local path
! -pw -i "1+a[\$(touch $pwn)]" "$pwkey1" 2>/dev/null || false
[ ! -e $pwn ]

# this next one should fail because no signature headers are given
if curl -f -s "http://127.0.0.1:$SCR_PORT/scr-get-password?args64=$(-serialize-args "$pwkey")" 2>/dev/null; then
  rc=$?
else
  rc=$?
fi
[ $rc = 22 ]

# a request that is not approved must fail rather than hand over the password.
# stderr is noisy on this one by design: curl reports the 401 and -ws prints a
# stack trace
rm -f $pw_approve_flag
! pw=$(-ssh-pw -i -1 "$pwkey1" 2>/dev/null)
[ -z "$pw" ]

rm -f $SCR_PASSWORD_FILE $SCR_SSH_USER_KNOWN_HOSTS $pw_approve_flag
SCR_PASSWORD_FILE=$SCR_PASSWORD_FILE_ORIG
